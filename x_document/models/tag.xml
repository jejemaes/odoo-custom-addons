<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Model -->
    <record id="model_document_tag" model="ir.model">
        <field name="model">x_document.tag</field>
        <field name="name">Tag</field>
    </record>

    <!-- Fields -->
    <record id="model_document_tag_field_name" model="ir.model.fields">
        <field name="ttype">char</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Name</field>
        <field name="model">x_document.tag</field>
        <field name="model_id" ref="model_document_tag"/>
        <field name="name">x_name</field>
        <field name="on_delete" eval="False"/>
        <field name="required" eval="True"/>
        <field name="translate">standard</field>
    </record>

    <record id="model_document_tag_field_category_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Category</field>
        <field name="model">x_document.tag</field>
        <field name="model_id" ref="model_document_tag"/>
        <field name="name">x_category_id</field>
        <field name="relation">x_document.tag_category</field>
    </record>

    <record id="model_document_tag_field_color" model="ir.model.fields">
        <field name="ttype">integer</field>
        <field name="field_description">Category's color</field>
        <field name="model">x_document.tag</field>
        <field name="model_id" ref="model_document_tag"/>
        <field name="name">x_color</field>
        <field name="related">x_category_id.x_color</field>
        <field name="readonly" eval="True"/>
    </record>

</odoo>
