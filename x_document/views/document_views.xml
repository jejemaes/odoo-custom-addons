<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="document_document_view_list" model="ir.ui.view" >
        <field name="name">document.x_document.document.list</field>
        <field name="model">x_document.document</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list js_class="document_list">
                <field name="x_name"/>
                <field name="x_user_id" widget="many2one_avatar_user"/>
                <field name="x_folder_id"/>
                <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'x_color'}"/>
            </list>
        </field>
    </record>

    <record id="document_document_view_kanban" model="ir.ui.view">
        <field name="name">document.x_document.document.kanban</field>
        <field name="model">x_document.document</field>
        <field name="arch" type="xml">
            <kanban js_class="document_kanban" class="o_document_kanban">
                <field name="id"/>
                <field name="x_document_type"/>
                <field name="x_user_id"/>
                <field name="x_mimetype"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable">
                          <a type="open" class="dropdown-item">Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                          <a type="delete" class="dropdown-item">Delete</a>
                        </t>
                    </t>
                    <t t-name="card">
                        <div class="d-flex flex-column o_kanban_attachment o_document_kanban_record h-100 pb-1" t-att-data-id="record.id.raw_value">
                            <div>
                                <div class="o_kanban_image_wrapper d-flex justify-content-center position-relative oe_kanban_previewer p-2" title="">
                                    <t t-if="record.x_document_type.raw_value == 'file'">
                                        <t t-set="webimage" t-value="new RegExp('image.*(gif|jpeg|jpg|png|webp)').test(record.x_mimetype.value)"/>
                                        <t t-if="webimage">
                                            <img t-attf-src="/web/image/x_document.document/#{record.id.raw_value}/x_file_content/150x150" height="120" alt="Document" class="o_attachment_image"/>
                                        </t>
                                        <t t-else="">
                                            <t t-if="record.x_mimetype.raw_value">
                                                <div class="o_image o_image_thumbnail" t-att-data-mimetype="record.x_mimetype.value"/>
                                            </t>
                                            <t t-else="">
                                                <field name="x_thumbnail" widget="image" options="{'size': [100, 100]}"/>
                                            </t>
                                        </t>
                                    </t>
                                    <t t-if="record.x_document_type.raw_value == 'url'">
                                        <i class="fa fa-link fa-6x text-muted" title="url"/>
                                    </t>
                                    <t t-if="record.x_document_type.raw_value == 'text'">
                                        <i class="fa fa-file-text-o fa-8x text-muted" title="text file"/>
                                    </t>
                                </div>
                            </div>

                            <div class="flex-shrink-1 flex-auto">
                                <div class="p-2 pb-0">
                                    <div class="fw-bolder w-100 d-flex align-items-center">
                                        <div class="d-flex flex-grow-1 align-items-center gap-2 overflow-hidden">
                                            <field name="x_name" class="text-truncate" string="Document"/>
                                        </div>
                                        <div class="d-flex d-flex-row align-items-center ms-2 gap-2" t-if="record.x_document_type.raw_value != 'folder'">
                                            <field name="activity_ids" widget="kanban_activity"/>
                                            <field name="x_user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body text-truncate">
                                        <span class="text-muted" t-if="record.x_folder_id.raw_value">
                                            In <field name="x_folder_id"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <footer class="d-flex px-2">
                                <field name="x_tag_ids" class="d-block text-wrap" widget="many2many_tags" options="{'color_field': 'x_color'}"/>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="document_document_view_form" model="ir.ui.view" >
        <field name="name">document.x_document.document.form</field>
        <field name="model">x_document.document</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
              <header>
                    <button
                        type="action"
                        name="%(x_document.document_action_download)d"
                        string="Download"
                        data-hotkey="d"
                        title="Download"
                        invisible="x_document_type != 'file' or not id"/>
              </header>
              <sheet string="Documents">
                    <group name="document_technical">
                        <field name="id" invisible="1"/>
                        <field name="x_mimetype" invisible="1"/>
                        <field name="x_document_type" widget="radio" options="{'horizontal': True}" force_save="1" invisible="1"/>
                    </group>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Content" name="page_content">
                            <group>
                                <field name="x_file_content" required="x_document_type == 'file'" invisible="1"/>
                                <field name="x_file_content" readonly="1" widget="pdf_viewer" invisible="x_mimetype != 'application/pdf'" nolabel="1"/>
                                <field name="x_file_content" readonly="1" widget="image" invisible="'image' not in x_mimetype" nolabel="1" class="text-center"/>
                                <field name="x_text_content" nolabel="1" invisible="x_document_type != 'text'"/>
                                <field name="x_url" required="x_document_type == 'url'" invisible="x_document_type != 'url'" widget="url"/>
                            </group>
                        </page>
                        <page string="Details" name="document_details">
                            <group>
                                <group>
                                    <field name="x_folder_id" options="{'no_create':true}"/>
                                    <field widget="many2many_tags" name="x_tag_ids" options="{'no_create': true, 'color_field': 'x_color'}"/>
                                    <field name="x_mimetype"/>
                                </group>
                                <group>
                                    <field name="x_user_id" options="{'no_create':true}"/>
                                    <field name="x_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                  </sheet>
                  <chatter/>
            </form>
        </field>
    </record>

    <record id="document_document_view_search" model="ir.ui.view" >
        <field name="name">document.x_document.document.search</field>
        <field name="model">x_document.document</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_user_id"/>
                <field name="x_folder_id"/>
                <filter string="Mes Documents" name="my_x_document.document" domain="[['x_user_id', '=', uid]]"/>
                <separator/>
                <filter string="Url" name="filter_type_url" domain="[['x_document_type', '=', 'url']]"/>
                <filter string="Text" name="filter_type_text" domain="[['x_document_type', '=', 'text']]"/>
                <filter string="PDF" name="filter_type_pdf" domain="[('x_mimetype', 'ilike', 'pdf')]"/>
                <filter string="Image" name="filter_type_img" domain="[('x_mimetype', 'ilike', 'image')]"/>
                <filter string="Video" name="filter_type_video" domain="[('x_mimetype', 'ilike', 'video')]"/>
                <separator/>
                <group>
                    <filter name="groupby_x_user" string="Responsable" context="{'group_by': 'x_user_id'}" domain="[]"/>
                    <filter name="groupby_x_folder_id" string="Folder" context="{'group_by': 'x_folder_id'}" domain="[]"/>
                </group>
                <searchpanel>
                    <field name="x_folder_id" select="one" icon="fa-folder"/>
                    <field name="x_tag_ids" select="multi" groupby="x_category_id" icon="fa-tag" enable_counters="1" expand="1"/>
                    <field name="x_user_id" select="multi" icon="fa-user"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="document_document_action" model="ir.actions.act_window" >
        <field name="name">Documents</field>
        <field name="res_model">x_document.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_x_user_id': uid,
            'default_x_document_type':
            'file', 'search_default_root_documents': 1,
            'default_x_date': (datetime.date.today()).strftime('%Y-%m-%d'),
        }</field>
    </record>

</odoo>
