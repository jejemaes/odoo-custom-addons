<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="document_tag_view_list" model="ir.ui.view" >
        <field name="name">document.x_document.tag.list</field>
        <field name="model">x_document.tag</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="x_name"/>
                <field name="x_category_id"/>
                <field name="x_color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="document_tag_view_form" model="ir.ui.view" >
        <field name="name">document.x_document.tag.form</field>
        <field name="model">x_document.tag</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet string="Tag">
                    <div class="oe_title">
                        <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="document_tag_view_search" model="ir.ui.view" >
        <field name="name">document.x_document.tag.search</field>
        <field name="model">x_document.tag</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_category_id"/>
                <group>
                    <filter string="Category" name="category" context="{'group_by':'x_category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Views -->
    <record id="document_tag_action" model="ir.actions.act_window" >
        <field name="name">Tag</field>
        <field name="res_model">x_document.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
