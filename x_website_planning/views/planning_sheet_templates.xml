<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Public page of a planning sheet, reachable through /website/action/planning/<token>.
    Standalone layout (no website chrome) so the page renders the same for anonymous visitors.
-->
<template id="planning_sheet_public_page" name="Planning Sheet Public Page">
    <t t-call="web.layout">
        <t t-set="html_data" t-value="{'lang': 'en-US'}"/>
        <t t-set="title" t-value="sheet.x_name"/>
        <t t-set="head">
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <meta name="robots" content="noindex, nofollow"/>
            <style>
                :root {
                    --x-bg: #f4f5f8;
                    --x-card: #ffffff;
                    --x-ink: #23252b;
                    --x-muted: #6b7280;
                    --x-accent: #714b67;
                    --x-border: #e5e7eb;
                }
                * { box-sizing: border-box; }
                body {
                    margin: 0;
                    background: var(--x-bg);
                    color: var(--x-ink);
                    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                    line-height: 1.5;
                }
                .x-wrap { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
                .x-hero {
                    background: linear-gradient(135deg, var(--x-accent), #017e84);
                    color: #fff;
                    border-radius: 14px;
                    padding: 28px 32px;
                    margin-bottom: 28px;
                    box-shadow: 0 6px 24px rgba(0,0,0,.12);
                }
                .x-hero h1 { margin: 0 0 6px; font-size: 2rem; font-weight: 700; }
                .x-hero .x-sub { opacity: .9; font-size: 1rem; }
                .x-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
                .x-stat {
                    background: rgba(255,255,255,.18);
                    border: 1px solid rgba(255,255,255,.28);
                    border-radius: 999px;
                    padding: 5px 14px;
                    font-size: .875rem;
                    font-weight: 600;
                }
                .x-day { margin-bottom: 26px; }
                .x-day-title {
                    font-size: 1.1rem;
                    font-weight: 700;
                    text-transform: capitalize;
                    margin: 0 0 10px;
                    padding-left: 4px;
                }
                .x-day-title small { color: var(--x-muted); font-weight: 500; margin-left: 8px; }
                .x-card {
                    background: var(--x-card);
                    border-radius: 12px;
                    box-shadow: 0 2px 10px rgba(0,0,0,.06);
                    overflow: hidden;
                }
                .x-role { border-top: 1px solid var(--x-border); }
                .x-role:first-child { border-top: 0; }
                .x-role-head {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 12px 18px;
                    font-weight: 700;
                    background: #fafafb;
                }
                .x-dot { width: 12px; height: 12px; border-radius: 50%; flex: 0 0 auto; }
                .x-role-count { color: var(--x-muted); font-weight: 500; font-size: .875rem; }
                table { width: 100%; border-collapse: collapse; }
                td, th { padding: 9px 18px; text-align: left; font-size: .9375rem; }
                thead th {
                    font-size: .75rem;
                    text-transform: uppercase;
                    letter-spacing: .04em;
                    color: var(--x-muted);
                    font-weight: 600;
                    border-bottom: 1px solid var(--x-border);
                }
                tbody tr + tr td { border-top: 1px solid #f1f2f4; }
                .x-time { font-variant-numeric: tabular-nums; white-space: nowrap; }
                .x-pill {
                    display: inline-block;
                    border-radius: 999px;
                    padding: 2px 12px;
                    font-size: .8125rem;
                    font-weight: 600;
                }
                .x-assigned { background: #e6f4ea; color: #17643b; }
                .x-free { background: #fdecea; color: #a4262c; }
                .x-note {
                    background: #fffbe7;
                    border-left: 4px solid #f7cd1f;
                    border-radius: 8px;
                    padding: 16px 20px;
                    margin-top: 30px;
                }
                .x-note h2 { margin: 0 0 8px; font-size: 1rem; text-transform: uppercase; letter-spacing: .04em; color: #8a6d00; }
                .x-empty { background: var(--x-card); border-radius: 12px; padding: 40px; text-align: center; color: var(--x-muted); }
                .x-foot { margin-top: 34px; text-align: center; color: var(--x-muted); font-size: .8125rem; }
                .x-alert { border-radius: 10px; padding: 14px 18px; margin-bottom: 22px; font-weight: 600; }
                .x-alert-ok { background: #e6f4ea; color: #17643b; border-left: 4px solid #30c381; }
                .x-alert-err { background: #fdecea; color: #a4262c; border-left: 4px solid #f06050; }
                .x-pick { width: 46px; text-align: center; }
                .x-pick input { width: 18px; height: 18px; cursor: pointer; accent-color: var(--x-accent); }
                .x-take {
                    background: var(--x-card);
                    border-radius: 12px;
                    box-shadow: 0 2px 10px rgba(0,0,0,.06);
                    padding: 22px 24px;
                    margin-top: 30px;
                    border-top: 4px solid var(--x-accent);
                }
                .x-take h2 { margin: 0 0 4px; font-size: 1.15rem; }
                .x-take p { margin: 0 0 18px; color: var(--x-muted); font-size: .9375rem; }
                .x-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
                .x-field { display: flex; flex-direction: column; gap: 5px; }
                .x-field label { font-size: .8125rem; font-weight: 600; color: var(--x-muted); }
                .x-field input {
                    border: 1px solid var(--x-border);
                    border-radius: 8px;
                    padding: 9px 12px;
                    font-size: .9375rem;
                    font-family: inherit;
                    background: #fff;
                    color: var(--x-ink);
                }
                .x-field input:focus { outline: none; border-color: var(--x-accent); box-shadow: 0 0 0 3px rgba(113,75,103,.14); }
                .x-btn {
                    margin-top: 18px;
                    background: var(--x-accent);
                    color: #fff;
                    border: 0;
                    border-radius: 8px;
                    padding: 11px 26px;
                    font-size: .9375rem;
                    font-weight: 700;
                    font-family: inherit;
                    cursor: pointer;
                }
                .x-btn:hover { filter: brightness(1.12); }
                @media (max-width: 640px) {
                    .x-grid { grid-template-columns: 1fr; }
                }
                @media (max-width: 640px) {
                    .x-hero { padding: 22px; }
                    .x-hero h1 { font-size: 1.5rem; }
                    td, th { padding: 8px 12px; }
                }
            </style>
        </t>

        <!-- Odoo color palette, indexed by the role color -->
        <t t-set="palette" t-value="['#9ca3af', '#f06050', '#f4a460', '#f7cd1f', '#6cc1ed', '#814968', '#eb7e7f', '#2c8397', '#475577', '#d6145f', '#30c381', '#9365b8']"/>
        <!-- Render times in the planning owner timezone, so every visitor sees the same hours as the PDF -->
        <t t-set="tz" t-value="sheet.x_user_id.tz or sheet.env.company.partner_id.tz or 'UTC'"/>
        <t t-set="unassigned" t-value="shifts.filtered(lambda s: not s.x_partner_id)"/>
        <!-- Visitors may only pick shifts when the option is on and something is actually free -->
        <t t-set="can_self_assign" t-value="sheet.x_self_assign and unassigned"/>

        <div class="x-wrap">

            <div class="x-hero">
                <h1 t-esc="sheet.x_name"/>
                <div class="x-sub">
                    <span t-field="sheet.x_date_start"/> &#8594; <span t-field="sheet.x_date_end"/>
                    <t t-if="sheet.x_user_id"> · <t t-esc="sheet.x_user_id.name"/></t>
                </div>
                <div class="x-stats">
                    <span class="x-stat"><t t-esc="len(shifts)"/> shifts</span>
                    <span class="x-stat" t-if="unassigned"><t t-esc="len(unassigned)"/> to be filled</span>
                    <span class="x-stat" t-if="len(shifts) and not unassigned">Fully staffed</span>
                </div>
            </div>

            <div t-if="taken" class="x-alert x-alert-ok">
                Thanks! You are now assigned to <t t-esc="taken"/> shift<t t-if="taken &gt; 1">s</t>.
            </div>
            <div t-if="error" class="x-alert x-alert-err" t-esc="error"/>

            <t t-if="not shifts">
                <div class="x-empty">No shift planned for this period.</div>
            </t>

            <!-- The whole listing lives in the form, so the checkboxes are submitted with the contact details -->
            <form method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

            <t t-set="days" t-value="sorted(set([s.x_start_datetime.date() for s in shifts]))"/>
            <t t-foreach="days" t-as="day">
                <t t-set="day_shifts" t-value="shifts.filtered(lambda s: s.x_start_datetime.date() == day)"/>
                <div class="x-day">
                    <h2 class="x-day-title">
                        <t t-esc="day.strftime('%A %d %B %Y')"/>
                        <small><t t-esc="len(day_shifts)"/> shifts</small>
                    </h2>
                    <div class="x-card">
                        <t t-set="roles" t-value="day_shifts.mapped('x_role_id')"/>
                        <t t-set="norole_shifts" t-value="day_shifts.filtered(lambda s: not s.x_role_id)"/>

                        <t t-foreach="roles" t-as="role">
                            <t t-set="role_shifts" t-value="day_shifts.filtered(lambda s: s.x_role_id == role)"/>
                            <t t-call="x_website_planning.planning_sheet_public_role_block">
                                <t t-set="block_label" t-value="role.x_name"/>
                                <t t-set="block_color" t-value="palette[role.x_color % 12]"/>
                                <t t-set="block_shifts" t-value="role_shifts"/>
                            </t>
                        </t>

                        <t t-if="norole_shifts">
                            <t t-call="x_website_planning.planning_sheet_public_role_block">
                                <t t-set="block_label">No role</t>
                                <t t-set="block_color" t-value="palette[0]"/>
                                <t t-set="block_shifts" t-value="norole_shifts"/>
                            </t>
                        </t>
                    </div>
                </div>
            </t>

            <div t-if="can_self_assign" class="x-take">
                <h2>Take a shift</h2>
                <p>Tick the shifts you want above, then leave your details. Your email is used to recognise you.</p>
                <div class="x-grid">
                    <div class="x-field">
                        <label for="firstname">First Name</label>
                        <input type="text" id="firstname" name="firstname" required="required" t-att-value="values['firstname']"/>
                    </div>
                    <div class="x-field">
                        <label for="lastname">Last Name</label>
                        <input type="text" id="lastname" name="lastname" required="required" t-att-value="values['lastname']"/>
                    </div>
                    <div class="x-field">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required="required" t-att-value="values['email']"/>
                    </div>
                    <div class="x-field">
                        <label for="phone">Mobile</label>
                        <input type="tel" id="phone" name="phone" required="required" t-att-value="values['phone']"/>
                    </div>
                </div>
                <button type="submit" class="x-btn">Confirm my shifts</button>
            </div>

            </form>

            <div class="x-foot">
                Planning shared on <t t-esc="datetime.date.today().strftime('%d %B %Y')"/>
            </div>

        </div>
    </t>
</template>

<!-- One role group inside a day card -->
<template id="planning_sheet_public_role_block" name="Planning Sheet Public Role Block">
    <div class="x-role">
        <div class="x-role-head">
            <span class="x-dot" t-attf-style="background: #{block_color};"/>
            <span t-esc="block_label"/>
            <span class="x-role-count">(<t t-esc="len(block_shifts)"/>)</span>
        </div>
        <table>
            <thead>
                <tr>
                    <th t-if="can_self_assign" class="x-pick">Take</th>
                    <th style="width: 15%">Start</th>
                    <th style="width: 15%">End</th>
                    <th>Assignee</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="block_shifts.sorted('x_partner_id')" t-as="shift">
                    <td t-if="can_self_assign" class="x-pick">
                        <input t-if="not shift.x_partner_id" type="checkbox" name="shift_ids"
                               t-att-value="shift.id"
                               t-att-checked="'checked' if shift.id in selected_ids else None"
                               t-attf-aria-label="Take the shift starting at #{shift.x_start_datetime}"/>
                    </td>
                    <td class="x-time"><span t-field="shift.x_start_datetime" t-options="{'format': 'HH:mm', 'tz_name': tz}"/></td>
                    <td class="x-time"><span t-field="shift.x_end_datetime" t-options="{'format': 'HH:mm', 'tz_name': tz}"/></td>
                    <td>
                        <span t-if="shift.x_partner_id" class="x-pill x-assigned" t-esc="shift.x_partner_id.name"/>
                        <span t-else="" class="x-pill x-free">Unassigned</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</template>

</odoo>
