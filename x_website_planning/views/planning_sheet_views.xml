<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="planning_sheet_view_form" model="ir.ui.view">
        <field name="name">x_planning.sheet.form.website</field>
        <field name="model">x_planning.sheet</field>
        <field name="inherit_id" ref="x_planning.planning_sheet_view_form"/>
        <field name="arch" type="xml">
            <group name="sheet_note" position="before">
                <group name="sheet_sharing" string="Sharing">
                    <field name="x_is_public"/>
                    <field name="x_self_assign" invisible="not x_is_public"/>
                    <field name="x_public_token" invisible="1"/>
                    <field name="x_public_url" widget="CopyClipboardURL" invisible="not x_is_public"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
