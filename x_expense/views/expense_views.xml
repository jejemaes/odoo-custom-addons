<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="expense_expense_view_list_my" model="ir.ui.view" >
        <field name="name">x_expense.expense.list</field>
        <field name="model">x_expense.expense</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="x_name"/>
                <field name="x_state" decoration-success="x_state == 'approved'" decoration-info="x_state == 'submit'" decoration-primary="x_state == 'done'" decoration-muted="x_state == 'cancel'" widget="badge"/>
                <field name="x_price" sum="Total"/>
                <field name="x_analytic_account_id" optional="hide"/>
                <field name="x_product_id" optional="hide"/>
                <field name="x_payment_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="expense_expense_view_list_submitted" model="ir.ui.view" >
        <field name="name">x_expense.expense.list.submitted</field>
        <field name="model">x_expense.expense</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="create_date desc">
                <field name="x_name"/>
                <field name="x_partner_id"/>
                <field name="x_state" decoration-success="x_state == 'approved'" decoration-info="x_state == 'submit'" decoration-primary="x_state == 'done'" decoration-muted="x_state == 'cancel'" widget="badge"/>
                <field name="x_analytic_account_id"/>
                <field name="x_price" sum="Total"/>
                <field name="x_product_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="expense_expense_view_list_approved" model="ir.ui.view" >
        <field name="name">x_expense.expense.list.approved</field>
        <field name="model">x_expense.expense</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="create_date desc">
                <field name="x_name"/>
                <field name="x_partner_id"/>
                <field name="x_state" decoration-success="x_state == 'approved'" decoration-info="x_state == 'submit'" decoration-primary="x_state == 'done'" decoration-muted="x_state == 'cancel'" widget="badge"/>
                <field name="x_payment_date" optional="show"/>
                <field name="x_price" sum="Total"/>
                <field name="x_analytic_account_id" optional="hide"/>
                <field name="x_product_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="expense_expense_view_form" model="ir.ui.view" >
        <field name="name">x_expense.expense.form</field>
        <field name="model">x_expense.expense</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header invisible="id == False">
                    <button
                        type="action"
                        name="%(x_expense.expense_expense_action_submit_expense)d"
                        string="Submit"
                        data-hotkey="s"
                        title="Submit"
                        class="btn-primary"
                        invisible="x_state != 'draft'"/>
                    <button
                        type="action"
                        name="%(x_expense.expense_expense_action_approve_expense)d"
                        string="Approve"
                        data-hotkey="a"
                        title="Approve"
                        class="btn-primary"
                        invisible="x_state != 'submit'"
                        groups="x_expense.group_expense_manager"/>
                    <button
                        type="action"
                        name="%(x_expense.expense_expense_action_pay_expense)d"
                        string="Pay"
                        data-hotkey="p"
                        title="Pay"
                        class="btn-primary"
                        invisible="x_state != 'approved'"
                        groups="x_expense.group_expense_manager"/>
                    <button
                        type="action"
                        name="%(x_expense.expense_expense_action_cancel_expense)d"
                        string="Cancel"
                        data-hotkey="c"
                        title="Cancel"
                        class="btn-secondary"
                        invisible="x_state not in ['draft', 'submit', 'approved', 'done']"/>
                    <button
                        type="action"
                        name="%(x_expense.expense_expense_action_reset_expense)d"
                        string="Reset to Draft"
                        data-hotkey="c"
                        title="Reset"
                        class="btn-primary"
                        invisible="x_state not in ['cancel']"/>
                    <field name="x_state" widget="statusbar" statusbar_visible="draft,submit,approved,done,cancel" readonly="1"/>
                </header>
                <sheet string="Expenses">
                    <group name="expense_technical">
                        <field name="x_mimetype" invisible="1"/>
                        <field name="x_state" widget="radio" options="{'horizontal': True}" force_save="1" invisible="1"/>
                    </group>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" placeholder="Expense for ...." readonly="x_state in ['approved', 'done', 'cancel']"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_user_id" readonly="x_state in ['approved', 'done', 'cancel']"/>
                            <field name="x_partner_id" readonly="x_state in ['approved', 'done', 'cancel']"/>
                            <field name="x_partner_email" readonly="x_state in ['approved', 'done', 'cancel']"/>
                            <field name="x_date" required="1" readonly="x_state != 'draft'"/>
                        </group>
                        <group>
                            <field name="x_product_id" readonly="x_state != 'draft'"/>
                            <field name="x_price" readonly="x_state != 'draft'"/>
                            <field name="x_analytic_account_id" readonly="x_state in ['approved', 'done', 'cancel']"/>
                            <field name="x_payment_date" readonly="x_state in ['draft', 'submit', 'approved', 'cancel']"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="page_content">
                            <group>
                                <field name="x_file_content" readonly="x_state != 'draft'" required="1" nolabel="1"/>
                            </group>
                            <group>
                                <field name="x_file_content" readonly="1" widget="pdf_viewer" invisible="x_mimetype != 'application/pdf'" nolabel="1"/>
                                <field name="x_file_content" readonly="1" widget="image" invisible="'image' not in x_mimetype" nolabel="1" class="text-center"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="expense_expense_view_search" model="ir.ui.view" >
        <field name="name">x_expense.expense.search</field>
        <field name="model">x_expense.expense</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_partner_id"/>
                <field name="x_analytic_account_id"/>
                <field name="x_product_id"/>
                <filter string="My Expenses" name="my_expense" domain="[['x_user_id', '=', uid]]"/>
                <separator/>
                <filter string="To Submit" name="filter_state_draft" domain="[['x_state', '=', 'draft']]"/>
                <filter string="To Approve" name="filter_state_submit" domain="[['x_state', '=', 'submit']]"/>
                <filter string="To Pay" name="filter_state_approve" domain="[['x_state', '=', 'approved']]"/>
                <filter string="Cancel" name="filter_state_cancel" domain="[['x_state', '=', 'cancel']]"/>
                <filter string="Done" name="filter_state_done" domain="[('x_state', '=', 'done')]"/>
                <separator/>
                <group>
                    <filter name="groupby_x_partner" string="Partner" context="{'group_by': 'x_partner_id'}" domain="[]"/>
                    <filter name="groupby_x_user" string="User" context="{'group_by': 'x_user_id'}" domain="[]"/>
                    <filter name="groupby_x_analytic_account_id" string="Analytic Account" context="{'group_by': 'x_analytic_account_id'}" domain="[]"/>
                    <filter name="groupby_x_product_id" string="Product" context="{'group_by': 'x_product_id'}" domain="[]"/>
                    <filter name="groupby_x_state" string="State" context="{'group_by': 'x_state'}" domain="[]"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="expense_expense_action_my" model="ir.actions.act_window" >
        <field name="name">Expenses</field>
        <field name="res_model">x_expense.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{
            'default_x_user_id': uid,
            'default_x_date': (datetime.date.today()).strftime('%Y-%m-%d'),
            'search_default_my_expense': 1,
        }</field>
    </record>
    <record id="expense_expense_action_my_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="expense_expense_view_list_my"/>
        <field name="act_window_id" ref="expense_expense_action_my"/>
    </record>
    <record id="expense_expense_action_my_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="expense_expense_view_form"/>
        <field name="act_window_id" ref="expense_expense_action_my"/>
    </record>


    <record id="expense_expense_action_to_approve" model="ir.actions.act_window" >
        <field name="name">Expenses to Approve</field>
        <field name="res_model">x_expense.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_state', 'in', ['submit'])]</field>
        <field name="context">{
            'default_x_user_id': uid,
            'default_x_date': (datetime.date.today()).strftime('%Y-%m-%d'),
            'search_default_groupby_x_partner': 1,
        }</field>
    </record>
    <record id="expense_expense_action_to_approve_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="expense_expense_view_list_submitted"/>
        <field name="act_window_id" ref="expense_expense_action_to_approve"/>
    </record>
    <record id="expense_expense_action_to_approve_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="expense_expense_view_form"/>
        <field name="act_window_id" ref="expense_expense_action_to_approve"/>
    </record>

    <record id="expense_expense_action_to_pay" model="ir.actions.act_window" >
        <field name="name">Expenses to Pay</field>
        <field name="res_model">x_expense.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_state', 'in', ['approved', 'done', 'cancel'])]</field>
        <field name="context">{
            'default_x_user_id': uid,
            'default_x_date': (datetime.date.today()).strftime('%Y-%m-%d'),
            'search_default_filter_state_approve': 1,
        }</field>
    </record>
    <record id="expense_expense_action_to_approve_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="expense_expense_view_list_approved"/>
        <field name="act_window_id" ref="expense_expense_action_to_pay"/>
    </record>
    <record id="expense_expense_action_to_approve_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="expense_expense_view_form"/>
        <field name="act_window_id" ref="expense_expense_action_to_pay"/>
    </record>

</odoo>
