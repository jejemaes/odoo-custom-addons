<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="0">
        <!-- Privilege and groups -->
        <record model="res.groups.privilege" id="res_groups_privilege_expense">
            <field name="name">Expense</field>
            <field name="sequence">18</field>
            <field name="category_id" ref="base.module_category_accounting"/>
        </record>

        <record id="group_expense_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_expense"/>
        </record>

        <record id="group_expense_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_expense"/>
            <field name="implied_ids" eval="[(4, ref('group_expense_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- rules -->

        <record id="ir_rule_expense_expense_user_read_own" model="ir.rule">
            <field name="name">User only read its own expense</field>
            <field name="model_id" ref="model_expense_expense"/>
            <field name="domain_force">[
               ('x_user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_expense_user'))]"/>
        </record>

        <record id="ir_rule_expense_expense_user_not_draft" model="ir.rule">
            <field name="name">User can't modify an expense that is not in draft state</field>
            <field name="model_id" ref="model_expense_expense"/>
            <field name="domain_force">[
                '&amp;', ('x_user_id', '=', user.id), ('x_state', '!=', 'draft')
            ]</field>
            <field name="groups" eval="[(4, ref('group_expense_user'))]"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="ir_rule_expense_expense_manager" model="ir.rule">
            <field name="name">Manager can do everything</field>
            <field name="model_id" ref="model_expense_expense"/>
            <field name="domain_force">[
               (1, '=', 1)
            ]</field>
            <field name="groups" eval="[(4, ref('group_expense_manager'))]"/>
        </record>

    </data>
</odoo>
