<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<!--
		View Search
	-->
    <record id="project_task_view_search" model="ir.ui.view">
        <field name="name">x_project.task.search</field>
        <field name="model">x_project.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="x_name"/>
                <field name="x_user_ids"/>
                <field name="x_stage_id"/>
                <separator/>
                <filter name="filter_my_tasks" string="My Tasks" domain="[('x_user_ids', '=', uid)]"/>
                <separator/>
                <filter name="filter_open" string="Open" domain="[('x_stage_id.x_is_closing', '=', False)]"/>
                <filter name="filter_close" string="Closed" domain="[('x_stage_id.x_is_closing', '=', True)]"/>
                <group>
                    <filter string="User" name="group_by_user_ids" context="{'group_by':'x_user_ids'}"/>
                    <filter string="Stage" name="group_by_stage_id" context="{'group_by':'x_stage_id'}"/>
                    <filter string="Deadline Date" name="group_by_deadline" context="{'group_by':'x_deadline:week'}"/>
                </group>
           </search>
        </field>
    </record>

    <!--
        View Form
    -->
    <record id="project_task_view_form" model="ir.ui.view">
        <field name="name">x_project.task.form</field>
        <field name="model">x_project.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <field name="x_stage_id" widget="statusbar" options="{'clickable': '1'}" domain="[('x_project_ids', '=', x_project_id)]"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group name="task_details">
                        <group name="task_detail_left">
                            <field name="x_project_id" readonly="1"/>
                            <field name="x_user_ids" widget="many2many_avatar_user"/>
                        </group>
                        <group name="task_detail_right">
                            <field name="x_color" widget="color_picker"/>
                            <field name="x_deadline"/>
                            <field name="x_priority" widget="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="note" string="Note">
                            <field name="x_notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="project_task_view_form_my_tasks" model="ir.ui.view">
        <field name="name">x_project.task.form</field>
        <field name="model">x_project.task</field>
        <field name="inherit_id" ref="project_task_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_project_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>

    <!--
        View List
    -->
    <record id="project_task_view_list" model="ir.ui.view">
        <field name="name">x_project.task.list</field>
        <field name="model">x_project.task</field>
        <field name="arch" type="xml">
            <list string="Tasks" default_order="x_deadline desc, x_priority desc">
                <field name="x_sequence" widget="handle"/>
                <field name="x_name"/>
                <field name="x_project_id" column_invisible="1"/>
                <field name="x_user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="x_stage_color" column_invisible="1"/>
                <field name="x_stage_id" widget="badge" options="{'no_open': True, 'color_field': 'x_stage_color'}" domain="[('x_project_ids', '=', x_project_id)]" optional="show"/>
                <field name="x_deadline" optional="show" decoration-danger="x_deadline &lt; current_date"/>
                <field name="x_priority" optional="hide" widget="priority"/>
            </list>
        </field>
    </record>

    <record id="project_task_view_list_editable" model="ir.ui.view">
        <field name="name">x_project.task.list</field>
        <field name="model">x_project.task</field>
        <field name="inherit_id" ref="project_task_view_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable">top</attribute>
                <attribute name="multi_edit">1</attribute>
                <attribute name="open_form_view">1</attribute>
            </xpath>
            <xpath expr="//field[@name='x_stage_id']" position="replace">
                <field name="x_stage_id" domain="[('x_project_ids', '=', x_project_id)]" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_list_my_tasks" model="ir.ui.view">
        <field name="name">x_project.task.list</field>
        <field name="model">x_project.task</field>
        <field name="inherit_id" ref="x_project.project_task_view_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_project_id']" position="attributes">
                <attribute name="column_invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <!--
        View Kanban
    -->
    <record id="project_task_view_kanban" model="ir.ui.view">
        <field name="name">x_project.task.kanban</field>
        <field name="model">x_project.task</field>
        <field name="arch" type="xml">
            <kanban highlight_color="x_color" class="o_kanban_mobile" default_group_by="x_stage_id" default_order="x_deadline desc, id desc" js_class="project_task_kanban">
                <field name="x_name"/>
                <field name="x_user_ids"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <field name="x_color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <field class="fw-bold fs-2" name="x_name"/>
                        <div class="pt-2 pb-2">
                            <field name="x_priority" widget="priority"/>
                            <field name="x_deadline" widget="remaining_days"/>
                        </div>
                        <footer class="pt-1">
                            <div class="d-flex mt-auto align-items-center">
                            </div>
                            <div class="ms-auto d-flex">
                                <field name="x_user_ids" widget="many2many_avatar_user" class="ms-2"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="project_task_view_kanban_my_tasks" model="ir.ui.view">
        <field name="name">x_project.task.kanban</field>
        <field name="model">x_project.task</field>
        <field name="inherit_id" ref="project_task_view_kanban"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_priority']" position="before">
                <field name="x_project_id" class="text-muted"/>
            </xpath>
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by"></attribute>
            </xpath>
        </field>
    </record>

	<!--
		Action prom Project
	-->
    <record id="project_task_action_from_project" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">x_project.task</field>
        <field name="search_view_id" ref="project_task_view_search"/>
        <field name="domain">[('x_project_id', '=', active_id)]</field>
        <field name="context">{'default_x_project_id': active_id, 'search_default_filter_open': 1}</field>
    </record>

    <record id="project_task_action_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_task_view_list_editable"/>
        <field name="act_window_id" ref="project_task_action_from_project"/>
    </record>

    <record id="project_task_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_task_view_form"/>
        <field name="act_window_id" ref="project_task_action_from_project"/>
    </record>

    <!--
        Action My Tasks (Cross Project)
    -->
    <record id="project_task_action_my_tasks" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">x_project.task</field>
        <field name="search_view_id" ref="project_task_view_search"/>
        <field name="context">{'search_default_filter_my_tasks': 1, 'search_default_filter_open': 1}</field>
    </record>

    <record id="project_task_action_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_task_view_list_my_tasks"/>
        <field name="act_window_id" ref="project_task_action_my_tasks"/>
    </record>

    <record id="project_task_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_task_view_kanban_my_tasks"/>
        <field name="act_window_id" ref="project_task_action_my_tasks"/>
    </record>

    <record id="project_task_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="25"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_task_view_form_my_tasks"/>
        <field name="act_window_id" ref="project_task_action_my_tasks"/>
    </record>

</odoo>
