<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<!--
		View Search
	-->
    <record id="project_tag_view_search" model="ir.ui.view">
        <field name="name">x_project.tag.search</field>
        <field name="model">x_project.tag</field>
        <field name="arch" type="xml">
            <search string="Search Tags">
                <field name="x_name"/>
           </search>
        </field>
    </record>

    <!--
        View List
    -->
    <record id="project_tag_view_list" model="ir.ui.view">
        <field name="name">x_project.tag.list</field>
        <field name="model">x_project.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="top">
                <field name="x_name"/>
                <field name="x_color" widget="color_picker"/>
            </list>
        </field>
    </record>

	<!--
		Action
	-->
    <record id="project_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">x_project.tag</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="project_tag_view_search"/>
    </record>

    <record id="project_tag_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_tag_view_list"/>
        <field name="act_window_id" ref="project_tag_action"/>
    </record>

</odoo>
