<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<!--
		View Search
	-->
    <record id="project_stage_view_search" model="ir.ui.view">
        <field name="name">x_project.stage.search</field>
        <field name="model">x_project.stage</field>
        <field name="arch" type="xml">
            <search string="Search Stage">
                <field name="x_name"/>
           </search>
        </field>
    </record>

    <!--
        View Form
    -->
    <record id="project_stage_view_form" model="ir.ui.view">
        <field name="name">x_project.stage.form</field>
        <field name="model">x_project.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group name="stage_details">
                        <group name="stage_detail_left">
                            <field name="x_color" widget="color_picker"/>
                            <field name="x_sequence"/>
                        </group>
                        <group name="stage_detail_right">
                            <field name="x_project_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        View List
    -->
    <record id="project_stage_view_list" model="ir.ui.view">
        <field name="name">x_project.stage.list</field>
        <field name="model">x_project.stage</field>
        <field name="arch" type="xml">
            <list string="Stages">
                <field name="x_sequence" widget="handle"/>
                <field name="x_name"/>
                <field name="x_project_ids" widget="many2many_tags"/>
                <field name="x_color" widget="color_picker"/>
                <field name="x_is_closing"/>
            </list>
        </field>
    </record>

	<!--
		Action
	-->
    <record id="project_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">x_project.stage</field>
        <field name="search_view_id" ref="project_stage_view_search"/>
    </record>

    <record id="project_stage_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_stage_view_list"/>
        <field name="act_window_id" ref="project_stage_action"/>
    </record>

    <record id="project_stage_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_stage_view_form"/>
        <field name="act_window_id" ref="project_stage_action"/>
    </record>

</odoo>
