<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        View Form
    -->
    <record id="project_task_template_view_form" model="ir.ui.view">
        <field name="name">x_project.task.template.form</field>
        <field name="model">x_project.task.template</field>
        <field name="arch" type="xml">
            <form string="Task Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Task Name..."/>
                        </h1>
                    </div>
                    <group name="task_details">
                        <group name="task_detail_left">
                            <field name="x_user_ids" widget="many2many_avatar_user"/>
                        </group>
                        <group name="task_detail_right">
                            <field name="x_color" widget="color_picker"/>
                            <field name="x_priority" widget="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="note" string="Note">
                            <field name="x_notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
