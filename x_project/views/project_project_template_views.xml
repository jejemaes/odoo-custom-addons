<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Views
    -->
    <record id="project_project_template_view_search" model="ir.ui.view">
        <field name="name">x_project.project.template.search</field>
        <field name="model">x_project.project.template</field>
        <field name="arch" type="xml">
            <search string="Search Project">
                <field name="x_name"/>
                <filter name="filter_archived" string="Archived" domain="[('x_active', '=', False)]"/>
           </search>
        </field>
    </record>

    <record id="project_project_template_view_form" model="ir.ui.view">
        <field name="name">x_project.project.template.form</field>
        <field name="model">x_project.project.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet string="Project Template">
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Template Name..."/>
                        </h1>
                    </div>
                    <group name="project_project_template_detail">
                        <group name="project_project_template_detail_left">
                            <field name="x_mode" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="task_template_ids" string="Tasks">
                            <field name="x_task_template_ids" nolabel="1">
                                <list>
                                    <field name="x_sequence" widget="handle"/>
                                    <field name="x_name"/>
                                    <field name="x_color" widget="color_picker"/>
                                </list>
                            </field>
                        </page>
                        <page name="stage_ids" string="Stages">
                            <field name="x_stage_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="x_sequence" widget="handle"/>
                                    <field name="x_name"/>
                                    <field name="x_color" widget="color_picker"/>
                                    <field name="x_is_closing"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
              </form>
        </field>
    </record>

    <record id="project_project_template_view_tree" model="ir.ui.view">
        <field name="name">x_project.project.template.list</field>
        <field name="model">x_project.project.template</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Templates">
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <!--
        Actions
    -->
    <record id="project_project_template_action" model="ir.actions.act_window">
        <field name="name">Project Templates</field>
        <field name="res_model">x_project.project.template</field>
        <field name="search_view_id" ref="project_project_template_view_search"/>
    </record>

</odoo>