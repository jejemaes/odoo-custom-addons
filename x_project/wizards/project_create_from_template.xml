<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Model -->
    <record id="model_project_create_from_template" model="ir.model">
        <field name="name">Project Create From Tempalte</field>
        <field name="model">x_project.project_create_from_template</field>
        <field name="transient" eval="False"/>
        <field name="is_mail_thread" eval="False"/>
        <field name="is_mail_activity" eval="False"/>
    </record>

    <!-- Fields -->
    <record id="project_create_from_template_field_project_template_id" model="ir.model.fields">
        <field name="name">x_project_template_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Template</field>
        <field name="model">x_project.project_create_from_template</field>
        <field name="model_id" ref="model_project_create_from_template"/>
        <field name="relation">x_project.project.template</field>
        <field name="required" eval="True"/>
        <field name="on_delete">cascade</field>
    </record>

    <record id="project_create_from_template_field_name" model="ir.model.fields">
        <field name="name">x_name</field>
        <field name="ttype">char</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Name</field>
        <field name="model">x_project.project_create_from_template</field>
        <field name="model_id" ref="model_project_create_from_template"/>
        <field name="on_delete" eval="False"/>
        <field name="required" eval="True"/>
        <field name="translate">standard</field>
    </record>


