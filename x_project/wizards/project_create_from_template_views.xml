<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_create_from_template_view_form" model="ir.ui.view">
        <field name="name">x_project.project.create.from.template.form</field>
        <field name="model">x_project.project_create_from_template</field>
        <field name="arch" type="xml">
            <form string="Create Project from Template">
                <group>
                    <group>
                        <field name="x_project_template_id" options="{'no_create': True}"/>
                        <field name="x_name"/>
                    </group>
                </group>
                <footer>
                    <button string="Create Project" type="action" name="%(action_create_project_from_template)d" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" type="object" class="btn btn-secondary oe_inline"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="project_create_from_template_action" model="ir.actions.act_window">
        <field name="name">Create Project from Template</field>
        <field name="res_model">x_project.project_create_from_template</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_create_from_template_view_form"/>
        <field name="target">new</field>
    </record>

</odoo>
