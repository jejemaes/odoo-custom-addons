<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="rental_main_menu" model="ir.ui.menu">
        <field name="name">Rental</field>
        <field name="web_icon_data" type="base64" file="x_rental/static/description/icon.svg"/>
        <field name="sequence">32</field>
    </record>

    <record id="rental_main_schedule" model="ir.ui.menu">
        <field name="action" ref="rental_booking_action"/>
        <field name="name">Schedule</field>
        <field name="parent_id" ref="rental_main_menu"/>
    </record>

    <record id="rental_main_resource" model="ir.ui.menu">
        <field name="action" ref="resource_resource_action"/>
        <field name="name">Resources</field>
        <field name="parent_id" ref="rental_main_menu"/>
    </record>

    <!-- Activate hidden Sale Root menu -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="active" eval="True"/>
    </record>

</odoo>
