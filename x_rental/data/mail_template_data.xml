<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="email_template_rental_request_received" model="mail.template">
            <field name="name">Rental: Send Request Acknowledgment</field>
            <field name="model_id" ref="x_rental.model_rental_booking"/>
            <field name="subject">Rental Request: {{ object.x_name }} for {{ object.x_date_start }}</field>
            <field name="email_from">{{ object.x_user_id.email_formatted or False }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Used when someone is filling the website form and the booking is created as a request. This template is sent to every internal partner with the tag 'rental team'.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Your rental booking request <span style="font-weight: bold;" t-out="object.x_name or ''">My Super Event</span>
        for <span style="font-weight: bold;" t-out="object.x_resource_id.name">our material</span>.
        has been received.
        <br/>
        The requested period is from <t t-out="object.x_date_start" t-options='{"widget": "datetime", "date_only": True, "format": "long"}'>05/05/2026</t> to <t t-out="object.x_date_stop" t-options='{"widget": "datetime", "date_only": True, "format": "long"}'>06/05/2026</t>.
        <br/>
        We'll get back to you to confirm if the booking is possible.
        <br/>
        Do not hesitate to contact us by replyin to this email if you have any questions.
        <t t-if="not is_html_empty(object.x_user_id.signature)">
            <div>--<br/><t t-out="object.x_user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

</odoo>
