#. module: x_rental
#: model:mail.template,body_html:x_rental.email_template_rental_request_received
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello,\n"
"        <br/><br/>\n"
"        Your rental booking request <span style=\"font-weight: bold;\" t-out=\"object.x_name or ''\">My Super Event</span>\n"
"        for <span style=\"font-weight: bold;\" t-out=\"object.x_resource_id.name\">our material</span>.\n"
"        has been received.\n"
"        <br/>\n"
"        The requested period is from <t t-out=\"object.x_date_start\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;date_only&quot;: True, &quot;format&quot;: &quot;long&quot;}\">05/05/2026</t> to <t t-out=\"object.x_date_stop\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;date_only&quot;: True, &quot;format&quot;: &quot;long&quot;}\">06/05/2026</t>.\n"
"        <br/>\n"
"        We'll get back to you to confirm if the booking is possible.\n"
"        <br/>\n"
"        Do not hesitate to contact us by replyin to this email if you have any questions.\n"
"        <t t-if=\"not is_html_empty(object.x_user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.x_user_id.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Bonjour,\n"
"        <br/><br/>\n"
"        Votre demande de location <span style=\"font-weight: bold;\" t-out=\"object.x_name or ''\">My Super Event</span>\n"
"        pour <span style=\"font-weight: bold;\" t-out=\"object.x_resource_id.name\">our material</span>.\n"
"        a bien été recue.\n"
"        <br/>\n"
"        La période demandée est du <t t-out=\"object.x_date_start\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;date_only&quot;: True, &quot;format&quot;: &quot;long&quot;}\">05/05/2026</t> au <t t-out=\"object.x_date_stop\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;date_only&quot;: True, &quot;format&quot;: &quot;long&quot;}\">06/05/2026</t>.\n"
"        <br/>\n"
"        Nous revenons vers vous pour vous confirmer que la location est bien possible.\n"
"        <br/>\n"
"        N'hésitez pas à nous contacter en repondant à cet email, si vous avez des questions.\n"
"        <t t-if=\"not is_html_empty(object.x_user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.x_user_id.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"            "

