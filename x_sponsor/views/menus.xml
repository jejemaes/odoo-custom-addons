<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="sponsor_main_menu" model="ir.ui.menu">
        <field name="name">Sponsors</field>
        <field name="web_icon">fa fa-user-circle-o,#FBB130,#BC4242</field>
    </record>

    <record id="sponsor_main_sponsors" model="ir.ui.menu">
        <field name="action" ref="sponsor_sponsor_action"/>
        <field name="name">Sponsorship</field>
        <field name="parent_id" ref="sponsor_main_menu"/>
        <field name="sequence">10</field>
    </record>

    <record id="sponsor_main_contract" model="ir.ui.menu">
        <field name="action" ref="sponsor_contract_action"/>
        <field name="name">Contracts</field>
        <field name="parent_id" ref="sponsor_main_menu"/>
        <field name="sequence">20</field>
    </record>

    <record id="sponsor_main_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="sponsor_main_menu"/>
        <field name="sequence">1000</field>
    </record>

        <record id="sponsor_main_configuration_stage" model="ir.ui.menu">
            <field name="action" ref="sponsor_stage_action"/>
            <field name="name">Sponsors Stages</field>
            <field name="parent_id" ref="sponsor_main_configuration"/>
        </record>

        <record id="sponsor_main_configuration_payment_method" model="ir.ui.menu">
            <field name="action" ref="sponsor_payment_method_action"/>
            <field name="name">Payment Method</field>
            <field name="parent_id" ref="sponsor_main_configuration"/>
        </record>

</odoo>
