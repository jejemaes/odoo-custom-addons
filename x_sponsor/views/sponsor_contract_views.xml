<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="sponsor_contract_view_list" model="ir.ui.view">
        <field name="model">x_sponsor.contract</field>
        <field name="name">sponsor.contract.list</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list default_order="x_start_date desc">
                <field name="x_name"/>
                <field name="x_start_date"/>
                <field name="x_stop_date"/>
                <field name="x_user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="sponsor_contract_view_form" model="ir.ui.view">
        <field name="model">x_sponsor.contract</field>
        <field name="name">sponsor.contract.form</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="action"
                        name="%(x_sponsor.action_create_sponsorship_from_contract)d"
                        class="btn-primary"
                        string="Generate Contracts"
                        confirm="This will create a sponsor contract for each partner with the 'Sponsor' tag. Are you ok ?"
                        invisible="x_sponsor_count != 0">
                    </button>
                </header>
                <sheet string="Contract">
                <div class="oe_button_box" name="button_box" invisible="x_sponsor_count == 0">
                    <button class="oe_stat_button" name="%(sponsor_sponsor_action_from_contract)d" type="action" icon="fa-bars">
                        <field string="Sponsorships" name="x_sponsor_count" widget="statinfo"/>
                    </button>
                </div>
                <widget name="web_ribbon" text="Archivé" bg_color="text-bg-danger" invisible="x_active"/>
                <field name="x_active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_start_date"/>
                            <field name="x_stop_date"/>
                        </group>
                        <group>
                            <field name="x_user_id" widget="many2one_avatar_user" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line" name="lines">
                            <field name="x_line_ids">
                                <list editable="bottom" default_order="x_sequence asc,id desc">
                                    <field name="x_sequence" widget="handle"/>
                                    <field optional="show" name="x_product_id" required="True" on_change="1" can_create="True" can_write="True"/>
                                    <field optional="show" name="x_product_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Content">
                            <group>
                                <field name="x_content"/>
                            </group>
                        </page>
                    </notebook>
                  </sheet>
            </form>
        </field>
    </record>

    <record id="sponsor_contract_view_kanban" model="ir.ui.view">
        <field name="model">x_sponsor.contract</field>
        <field name="name">sponsor.contract.kanban</field>
        <field name="type">kanban</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" type="action" action="%(sponsor_sponsor_action_from_contract)d">
                <field name="x_name"/>
                <field name="x_user_id"/>
                <field name="x_active"/>
                <field name="x_start_date"/>
                <field name="x_stop_date"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <a t-if="record.x_active.raw_value" role="menuitem" type="archive" class="dropdown-item">Archive</a>
                        <a t-if="!record.x_active.raw_value" role="menuitem" type="unarchive" class="dropdown-item">Unarchive</a>
                    </t>
                    <t t-name="card">
                        <field class="fw-bold fs-2" name="x_name"/>

                        <div t-if="record.x_start_date.raw_value or record.x_stop_date.raw_value" class="text-muted d-flex align-items-baseline">
                            <span class="fa fa-clock-o me-2" title="Dates"/>
                            <field name="x_start_date" widget="daterange" options="{'end_date_field': 'x_stop_date'}"/>
                        </div>

                        <div class="d-flex pt-2 pb-2">
                            <div class="col-6">
                                <button class="btn btn-primary" type="action" name="%(sponsor_sponsor_action_from_contract)d">
                                    View Sponsors
                                </button>
                            </div>
                            <div class="col-6">
                                <ul class="list-unstyled">
                                    <li><field name="x_sponsor_count"/> Sponsors</li>
                                </ul>
                            </div>
                        </div>
                        <footer class="pt-1">
                            <div class="d-flex mt-auto align-items-center">
                            </div>
                            <div class="ms-auto d-flex">
                                <field name="x_user_id" widget="many2one_avatar_user" class="ms-2"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Actions -->
    <record id="sponsor_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">x_sponsor.contract</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
