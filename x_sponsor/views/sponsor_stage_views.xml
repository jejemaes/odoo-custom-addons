<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="sponsor_stage_view_list" model="ir.ui.view">
        <field name="model">x_sponsor.stage</field>
        <field name="name">sponsor.stage.list</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="x_sequence asc,id desc">
                <field name="x_sequence" widget="handle"/>
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="sponsor_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">x_sponsor.stage</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
