<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="sponsor_sponsor_view_list" model="ir.ui.view">
        <field name="model">x_sponsor.sponsor</field>
        <field name="name">sponsor.sponsor.list</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_partner_id"/>
                <field name="x_user_id" widget="many2one_avatar_user"/>
                <field name="x_status" decoration-success="x_status == 'done'" decoration-warning="x_payment_status == 'signed'" decoration-info="x_status == 'sent'" widget="badge"/>
                <field name="x_sponsor_contract_line_id" optional="show"/>
                <field name="x_payment_status" optional="show"/>
                <field name="x_payment_method_id" optional="show" decoration-success="x_payment_status == 'paid'" decoration-warning="x_payment_status == 'unpaid' and x_payment_method_id" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="sponsor_sponsor_view_kanban" model="ir.ui.view">
        <field name="model">x_sponsor.sponsor</field>
        <field name="name">sponsor.sponsor.kanban</field>
        <field name="type">kanban</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_status" default_order="id desc">
                <field name="x_payment_status"/>
                <templates>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                    <t t-name="card" class="flex-row">
                        <main>
                            <div name="kanban_header" class="d-flex">
                                <field name="x_priority" widget="boolean_favorite" nolabel="1"/>
                                <field name="display_name" class="h5"/>
                            </div>
                            <div name="kanban_body">
                                <field name="x_sponsor_contract_line_id" class="text-muted"/>
                            </div>
                            <footer>
                                <div t-if="record.x_payment_method_id.raw_value" t-attf-class="badge float-end #{record.x_payment_status.raw_value == 'paid' ? 'text-bg-success' : 'text-bg-warning'}">
                                    <field name="x_payment_method_id"/>
                                </div>
                                <div class="ms-auto d-flex align-items-center">
                                    <field class="ms-1" name="x_user_id" widget="kanban.many2one_avatar_user"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sponsor_sponsor_view_form" model="ir.ui.view">
        <field name="model">x_sponsor.sponsor</field>
        <field name="name">sponsor.sponsor.form</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="action"
                        name="%(x_sponsor.action_take_it)d"
                        class="btn-primary"
                        string="I take it"
                        invisible="x_user_id != False"/>
                    <button type="action"
                        name="%(x_sponsor.action_sponsor_send_request)d"
                        class="btn-primary"
                        string="Send"
                        invisible="x_status != 'draft'"/>
                    <button type="action"
                        name="%(x_sponsor.action_sponsor_send_contract)d"
                        class="btn-secondary"
                        string="Send"
                        invisible="x_status not in ['signed', 'done']"/>
                    <field name="x_status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet string="Sponsors">
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                <group>
                    <group string="Sponsor Contact">
                        <field name="x_partner_id" required="True" context="{'default_company_type': 'company'}"/>
                        <field name="x_partner_phone"/>
                        <field name="x_partner_email"/>
                    </group>
                    <group string="Internal Data">
                        <field name="x_user_id" widget="many2one_avatar_user"/>
                        <field name="x_date"/>
                        <field name="x_suffix_code" readonly="x_status != 'draft'"/>
                      </group>
                    </group>
                    <group>
                      <group string="Details">
                        <field name="x_sponsor_contract_id" options="{'create_name_field': 'x_name'}"/>
                        <field name="x_sponsor_contract_line_id" options="{'create_name_field':'x_name','no_quick_create':true,'no_open':true,'no_create':true,'search_threshold':0}" widget="radio" domain="[('x_sponsor_contract_id', '=', x_sponsor_contract_id)]"/>
                        <field name="x_total_amount" widget='monetary' options="{'currency_field': 'x_currency_id'}"/>
                        <field name="x_currency_id" invisible="1"/>
                      </group>
                      <group string="Payment">
                            <field name="x_payment_method_id" required="x_payment_status == 'paid'"/>
                            <field name="x_payment_status" groups="x_sponsor.group_sponsor_manager"/>
                            <field name="x_payment_status" readonly="1" groups="!x_sponsor.group_sponsor_manager"/>
                            <field name="x_payment_date" invisible="x_payment_status == 'unpaid'" required="x_payment_status == 'paid'"/>
                      </group>
                    </group>
                    <group string="Signature">
                        <group>
                            <field name="x_signature_date" required="x_signature"/>
                            <field name="x_signed_by"/>
                            <field name="x_signature" widget="signature"/>
                        </group>
                        <group>
                            <field name="x_signature_sponsee" widget="signature"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sponsor_sponsor_view_pivot" model="ir.ui.view">
        <field name="name">sponsor.sponsor.pivot</field>
        <field name="model">x_sponsor.sponsor</field>
        <field name="arch" type="xml">
            <pivot string="Contracts">
                <field name="x_total_amount" type="measure"/>
                <field name="x_sponsor_contract_line_id" type="row"/>
                <field name="x_payment_status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="sponsor_sponsor_view_form_search" model="ir.ui.view">
        <field name="name">sponsor.sponsor.search</field>
        <field name="model">x_sponsor.sponsor</field>
        <field name="arch" type="xml">
            <search string="Search Resource">
               <field name="x_name"/>
               <field name="x_sponsor_contract_id"/>
               <field name="x_user_id"/>
               <field name="x_partner_id"/>
               <separator/>
               <filter string="My Contracts" name="my_contract" domain="[('x_user_id','=', uid)]"/>
               <filter string="Unassigned" name="unassigned" domain="[('x_user_id','=', False)]"/>
               <separator/>
               <filter string="Open" name="open" domain="[('x_status', 'in', ['draft', 'sent', 'signed'])]"/>
               <filter string="Closed" name="closed" domain="[('x_status', 'in', ['done', 'cancelled'])]"/>
               <separator/>
               <filter string="Unpaid Contracts" name="unpaid_contract" domain="[('x_payment_status','=', 'unpaid')]"/>
               <filter string="Paid Contracts" name="paid_contract" domain="[('x_payment_status','=', 'paid')]"/>
               <group>
                    <filter string="Status" name="groupby_status" context="{'group_by':'x_status'}"/>
                    <filter string="User" name="groupby_user" context="{'group_by':'x_user_id'}"/>
                    <filter string="Customer" name="groupby_x_partner_id" context="{'group_by':'x_partner_id'}"/>
                    <filter string="Contract" name="groupby_x_sponsor_contract_id" context="{'group_by':'x_sponsor_contract_id'}"/>
                    <filter string="Chosen Option" name="groupby_x_sponsor_contract_line_id" context="{'group_by':'x_sponsor_contract_line_id'}"/>
                    <filter string="Payment Method" name="groupby_x_payment_method_id" context="{'group_by':'x_payment_method_id'}"/>
                </group>
           </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="sponsor_sponsor_action" model="ir.actions.act_window">
        <field name="name">Sponsors</field>
        <field name="res_model">x_sponsor.sponsor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_x_date': (datetime.date.today()).strftime('%Y-%m-%d'),
            'search_default_my_contract': 1,
        }</field>
    </record>

    <record id="sponsor_sponsor_action_from_contract" model="ir.actions.act_window">
        <field name="name">Sponsors</field>
        <field name="res_model">x_sponsor.sponsor</field>
        <field name="view_mode">kanban,list,form,pivot</field>
        <field name="context">{
            'default_x_date': (datetime.date.today()).strftime('%Y-%m-%d'),
            'default_x_sponsor_contract_id': active_id,
        }</field>
        <field name="domain">[("x_sponsor_contract_id", "=", active_id)]</field>
    </record>


</odoo>
