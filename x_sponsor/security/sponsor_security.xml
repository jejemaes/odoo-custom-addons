<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="0">
        <record model="res.groups.privilege" id="res_groups_privilege_sponsors">
            <field name="name">Sponsors</field>
            <field name="sequence">18</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_sponsor_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sponsors"/>
        </record>

        <record id="group_sponsor_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_sponsors"/>
            <field name="implied_ids" eval="[(4, ref('group_sponsor_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
