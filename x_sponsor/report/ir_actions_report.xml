<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_external_sponsor_contract" model="ir.actions.report">
        <field name="name">Contract</field>
        <field name="model">x_sponsor.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x_sponsor.report_sponsor_contract</field>
        <field name="report_file">x_sponsor.report_sponsor_contract</field>
        <field name="print_report_name">'%s - %s' % (object.x_name, object.x_prefix_code.replace('/','-'))</field>
        <field name="binding_model_id" ref="model_sponsor_contract"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_external_sponsor_sponsor" model="ir.actions.report">
        <field name="name">Contract</field>
        <field name="model">x_sponsor.sponsor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x_sponsor.report_sponsor_sponsor</field>
        <field name="report_file">x_sponsor.report_sponsor_sponsor</field>
        <field name="print_report_name">'%s - %s' % (object.x_sponsor_contract_id.x_name, object.x_code.replace('/','-'))</field>
        <field name="binding_model_id" ref="model_sponsor_sponsor"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
