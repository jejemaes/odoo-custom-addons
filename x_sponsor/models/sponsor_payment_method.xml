<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="model_sponsor_payment_method" model="ir.model">
        <field name="model">x_sponsor.payment_method</field>
        <field name="name">Payment Method</field>
    </record>

    <record id="sponsor_payment_method_field_name" model="ir.model.fields">
        <field name="ttype">char</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Name</field>
        <field name="model">x_sponsor.payment_method</field>
        <field name="model_id" ref="model_sponsor_payment_method"/>
        <field name="name">x_name</field>
        <field name="on_delete" eval="False"/>
        <field name="required" eval="True"/>
        <field name="translate">standard</field>
    </record>

    <record id="sponsor_payment_method_field_sequence" model="ir.model.fields">
        <field name="ttype">integer</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Sequence</field>
        <field name="model">x_sponsor.payment_method</field>
        <field name="model_id" ref="model_sponsor_payment_method"/>
        <field name="name">x_sequence</field>
        <field name="on_delete" eval="False"/>
    </record>

    <record id="sponsor_payment_method_field_internal" model="ir.model.fields">
        <field name="ttype">boolean</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Is Internal</field>
        <field name="model">x_sponsor.payment_method</field>
        <field name="model_id" ref="model_sponsor_payment_method"/>
        <field name="name">x_internal</field>
        <field name="on_delete" eval="False"/>
    </record>

</odoo>
