#. module: x_sponsor
#: model:mail.template,body_html:x_sponsor.mail_template_data_sponsor_sponsor_signed_contract
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.x_partner_id.name or ''\">Azure Interior</t><br/><br/>\n"
"        \n"
"        Please find attached the contract, which has been completed and signed in accordance with our agreement.\n"
"        <br/>\n"
"        If you have any questions or comments, please do not hesitate to contact us again.\n"
"        <br/>\n"
"        The contract will come into effect upon receipt of payment.\n"
"        <br/><br/>\n"
"        Thank you once again for your support.\n"
"        <br/><br/>\n"
"        Best regards,\n"
"        <t t-if=\"not is_html_empty(user.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <br/><br/>\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Bonjour <t t-out=\"object.x_partner_id.name or ''\">Azure Interior</t><br/><br/>\n"
"        \n"
"        Vous trouverez ci-joint le contract rempli et signé, conformément à ce que nous avons discuté.\n"
"        <br/><br/>\n"
"        Si vous avez des questions ou des remarques, n'hésitez pas à revenir vers nous !\n"
"        <br/>\n"
"        Le contrat prendra effet à la reception du paiement.\n"
"        <br/><br/>\n"
"        Encore un grand merci de votre soutien.\n"
"        <br/><br/>\n"
"        Bien à vous,\n"
"        <t t-if=\"not is_html_empty(user.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <br/><br/>\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"        "

#. module: x_sponsor
#: model:mail.template,body_html:x_sponsor.mail_template_data_sponsor_sponsor_request
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.x_partner_id.name or ''\">Azure Interior</t><br/><br/>\n"
"        We have heard that you can be interessed in sponsoring our association.\n"
"\n"
"        Here is proposal for <span style=\"font-weight:bold;\" t-out=\"object.x_sponsor_contract_id.x_name\">Contract Name</span> with different options to support us:\n"
"        </p><ul>\n"
"            <li t-foreach=\"object.x_sponsor_contract_id.x_line_ids\" t-as=\"line\">\n"
"                <t t-esc=\"line.x_name\"/> (<t t-esc=\"line.x_product_price\"/>)\n"
"            </li>\n"
"        </ul>\n"
"        \n"
"        You can reply this email to give us your choice.\n"
"        Do not hesitate to contact us if you have any questions.\n"
"        <br/><br/>\n"
"        Best regards,\n"
"        <t t-if=\"not is_html_empty(user.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <br/><br/>\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    \n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Bonjour <t t-out=\"object.x_partner_id.name or ''\">Azure Interior</t><br/><br/>\n"
"        Nous avons entendu que vous seriez interessé par soutenir notre association.\n"
"\n"
"        Voici notre proposition pour <span style=\"font-weight:bold;\" t-out=\"object.x_sponsor_contract_id.x_name\">Contract Name</span> avec différentes options pour nous soutenir:\n"
"        </p><ul>\n"
"            <li t-foreach=\"object.x_sponsor_contract_id.x_line_ids\" t-as=\"line\">\n"
"                <t t-esc=\"line.x_name\"/> (<t t-esc=\"line.x_product_price\"/>)\n"
"            </li>\n"
"        </ul>\n"
"        \n"
"        Vous pouvez nous donner votre choix en répondant à cet email.\n"
"        N'hésitez pas à nous contacter pour tous renseignements supplémentaire.\n"
"        <br/><br/>\n"
"        Bien à vous,\n"
"        <t t-if=\"not is_html_empty(user.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <br/><br/>\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    \n"
"</div>\n"
"        "

