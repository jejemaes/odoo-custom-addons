<?xml version="1.0" encoding="utf-8"?>
<odoo>

<data noupdate="1">
    
    <record id="mail_template_data_sponsor_sponsor_request" model="mail.template">
        <field name="name">Sponsor: Sponsorship Request</field>
        <field name="model_id" ref="x_sponsor.model_sponsor_sponsor"/>
        <field name="subject">Sponsorship Request from {{ object.x_sponsor_contract_id.x_company_id.name }}</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.x_partner_id.name or ''">Azure Interior</t><br/><br/>
        We have heard that you can be interessed in sponsoring our association.

        Here is proposal for <span style="font-weight:bold;" t-out="object.x_sponsor_contract_id.x_name">Contract Name</span> with different options to support us:
        <ul>
            <li t-foreach="object.x_sponsor_contract_id.x_line_ids" t-as="line">
                <t t-esc="line.x_name"/> (<t t-out="line.x_product_price" t-options="{'widget': 'monetary', 'display_currency': object.x_currency_id}"/> )
            </li>
        </ul>
        
        You can reply this email to give us your choice.
        Do not hesitate to contact us if you have any questions.
        <br/><br/>
        Best regards,
        <t t-if="not is_html_empty(user.signature)">
            <br/><br/>
            <div>--<br/><t t-out="user.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('x_sponsor.action_report_external_sponsor_sponsor'))]"/>          
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_data_sponsor_sponsor_signed_contract" model="mail.template">
        <field name="name">Sponsor: Sponsorship Signed Contract</field>
        <field name="model_id" ref="x_sponsor.model_sponsor_sponsor"/>
        <field name="subject">Sponsorship from {{ object.x_sponsor_contract_id.x_company_id.name }}</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.x_partner_id.name or ''">Azure Interior</t><br/><br/>
        
        Please find attached the contract, which has been completed and signed in accordance with our agreement.
        <br/>
        If you have any questions or comments, please do not hesitate to contact us again.
        <br/>
        The contract will come into effect upon receipt of payment.
        <br/><br/>
        Thank you once again for your support.
        <br/><br/>
        Best regards,
        <t t-if="not is_html_empty(user.signature)">
            <br/><br/>
            <div>--<br/><t t-out="user.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('x_sponsor.action_report_external_sponsor_sponsor'))]"/>          
        <field name="auto_delete" eval="True"/>
    </record>


</data>

</odoo>
