<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="sponsor_stage_new" model="x_sponsor.stage">
        <field name="x_name">New</field>
        <field name="x_sequence">5</field>
    </record>

    <record id="sponsor_stage_sent" model="x_sponsor.stage">
        <field name="x_name">Sent</field>
        <field name="x_sequence">10</field>
    </record>

    <record id="sponsor_stage_done" model="x_sponsor.stage">
        <field name="x_name">Done</field>
        <field name="x_sequence">15</field>
    </record>

    <record id="sponsor_stage_cancel" model="x_sponsor.stage">
        <field name="x_name">Cancel</field>
        <field name="x_sequence">20</field>
    </record>

    <function model="ir.default" name="set" eval="('x_sponsor.sponsor', 'x_stage_id', obj().env.ref('x_sponsor.sponsor_stage_new').id)"/>

</odoo>

