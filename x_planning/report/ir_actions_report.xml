<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_planning_sheet" model="report.paperformat">
        <field name="name">Planning Sheet (Landscape)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_planning_sheet" model="ir.actions.report">
        <field name="name">Planning Sheet</field>
        <field name="model">x_planning.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x_planning.report_planning_sheet</field>
        <field name="report_file">x_planning.report_planning_sheet</field>
        <field name="print_report_name">'Planning Sheet - %s' % (object.x_name)</field>
        <field name="paperformat_id" ref="paperformat_planning_sheet"/>
        <field name="binding_model_id" ref="model_planning_sheet"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
