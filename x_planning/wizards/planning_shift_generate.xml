<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Models -->
    <record id="model_planning_shift_generate" model="ir.model">
        <field name="name">Generate Shifts from Sheet</field>
        <field name="model">x_planning.shift_generate</field>
        <field name="transient" eval="False"/>
        <field name="is_mail_thread" eval="False"/>
        <field name="is_mail_activity" eval="False"/>
    </record>

    <record id="model_planning_shift_generate_line" model="ir.model">
        <field name="name">Generate Shifts from Sheet (Line)</field>
        <field name="model">x_planning.shift_generate_line</field>
        <field name="transient" eval="False"/>
        <field name="is_mail_thread" eval="False"/>
        <field name="is_mail_activity" eval="False"/>
    </record>

    <!-- Fields: wizard -->
    <record id="planning_shift_generate_field_sheet_id" model="ir.model.fields">
        <field name="name">x_sheet_id</field>
        <field name="ttype">many2one</field>
        <field name="field_description">Planning Sheet</field>
        <field name="model">x_planning.shift_generate</field>
        <field name="model_id" ref="model_planning_shift_generate"/>
        <field name="relation">x_planning.sheet</field>
        <field name="required" eval="True"/>
        <field name="on_delete">cascade</field>
    </record>

    <record id="planning_shift_generate_field_date" model="ir.model.fields">
        <field name="name">x_date</field>
        <field name="ttype">date</field>
        <field name="field_description">Day</field>
        <field name="model">x_planning.shift_generate</field>
        <field name="model_id" ref="model_planning_shift_generate"/>
        <field name="required" eval="True"/>
        <!-- Prefilled with the first day of the sheet, but the user stays free to change it -->
        <field name="readonly" eval="False"/>
        <field name="store" eval="True"/>
        <field name="depends">x_sheet_id</field>
        <field name="compute"><![CDATA[
for record in self:
    record["x_date"] = record.x_sheet_id.x_date_start
]]></field>
    </record>

    <!-- Fields: line -->
    <record id="planning_shift_generate_line_field_wizard_id" model="ir.model.fields">
        <field name="name">x_wizard_id</field>
        <field name="ttype">many2one</field>
        <field name="field_description">Wizard</field>
        <field name="model">x_planning.shift_generate_line</field>
        <field name="model_id" ref="model_planning_shift_generate_line"/>
        <field name="relation">x_planning.shift_generate</field>
        <field name="required" eval="True"/>
        <field name="on_delete">cascade</field>
    </record>

    <record id="planning_shift_generate_line_field_start_time" model="ir.model.fields">
        <field name="name">x_start_time</field>
        <field name="ttype">float</field>
        <field name="field_description">Start Time</field>
        <field name="model">x_planning.shift_generate_line</field>
        <field name="model_id" ref="model_planning_shift_generate_line"/>
        <field name="required" eval="True"/>
    </record>

    <record id="planning_shift_generate_line_field_end_time" model="ir.model.fields">
        <field name="name">x_end_time</field>
        <field name="ttype">float</field>
        <field name="field_description">End Time</field>
        <field name="model">x_planning.shift_generate_line</field>
        <field name="model_id" ref="model_planning_shift_generate_line"/>
        <field name="required" eval="True"/>
    </record>

    <record id="planning_shift_generate_line_field_role_id" model="ir.model.fields">
        <field name="name">x_role_id</field>
        <field name="ttype">many2one</field>
        <field name="field_description">Role</field>
        <field name="model">x_planning.shift_generate_line</field>
        <field name="model_id" ref="model_planning_shift_generate_line"/>
        <field name="relation">x_planning.role</field>
        <field name="required" eval="True"/>
        <field name="on_delete">cascade</field>
    </record>

    <record id="planning_shift_generate_line_field_count" model="ir.model.fields">
        <field name="name">x_count</field>
        <field name="ttype">integer</field>
        <field name="field_description">Number of Shifts</field>
        <field name="model">x_planning.shift_generate_line</field>
        <field name="model_id" ref="model_planning_shift_generate_line"/>
        <field name="required" eval="True"/>
    </record>

    <record id="planning_shift_generate_line_default_value_count" model="ir.default">
        <field name="field_id" ref="planning_shift_generate_line_field_count"/>
        <field name="json_value">1</field>
    </record>

    <!-- Fields: wizard one2many (after the inverse many2one) -->
    <record id="planning_shift_generate_field_line_ids" model="ir.model.fields">
        <field name="name">x_line_ids</field>
        <field name="ttype">one2many</field>
        <field name="field_description">Lines</field>
        <field name="model">x_planning.shift_generate</field>
        <field name="model_id" ref="model_planning_shift_generate"/>
        <field name="relation">x_planning.shift_generate_line</field>
        <field name="relation_field">x_wizard_id</field>
        <field name="relation_field_id" ref="planning_shift_generate_line_field_wizard_id"/>
    </record>

</odoo>
