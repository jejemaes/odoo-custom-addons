<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        View Search
    -->
    <record id="planning_shift_view_search" model="ir.ui.view">
        <field name="name">x_planning.shift.search</field>
        <field name="model">x_planning.shift</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="x_role_id"/>
                <field name="x_partner_id"/>
                <filter name="filter_my_shifts" string="My Shifts" domain="[('x_partner_id.user_ids', 'in', [uid])]"/>
                <filter name="filter_unassigned" string="Unassigned" domain="[('x_partner_id', '=', False)]"/>
                <separator/>
                <filter name="filter_start_datetime" string="Start Date" date="x_start_datetime"/>
                <filter name="filter_end_datetime" string="End Date" date="x_end_datetime"/>
                <group>
                    <filter name="group_by_day" string="Day" context="{'group_by': 'x_start_datetime:day'}"/>
                    <filter name="group_by_role" string="Role" context="{'group_by': 'x_role_id'}"/>
                    <filter name="group_by_assignee" string="Assignee" context="{'group_by': 'x_partner_id'}"/>
                </group>
           </search>
        </field>
    </record>

    <!--
        View Form
    -->
    <record id="planning_shift_view_form" model="ir.ui.view">
        <field name="name">x_planning.shift.form</field>
        <field name="model">x_planning.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">
                <sheet>
                    <group name="shift_details">
                        <group name="shift_detail_left">
                            <field name="x_role_id"/>
                            <field name="x_partner_id" context="{'default_type': 'contact'}"/>
                        </group>
                        <group name="shift_detail_right">
                            <label for="x_start_datetime"/>
                            <div class="d-flex">
                                <field name="x_start_datetime" string="Date" widget="daterange" options="{'end_date_field': 'x_end_datetime'}"/>
                                <field name="x_end_datetime" invisible="1"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        View Calendar
    -->
    <record id="planning_shift_view_calendar" model="ir.ui.view">
        <field name="name">x_planning.shift.calendar</field>
        <field name="model">x_planning.shift</field>
        <field name="arch" type="xml">
            <calendar string="Shifts" js_class="x_planning_shift_calendar" date_start="x_start_datetime" date_stop="x_end_datetime" color="x_role_id" mode="week" quick_create="0" event_open_popup="1">
                <field name="x_partner_id"/>
                <field name="x_role_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <!--
        View List
    -->
    <record id="planning_shift_view_list" model="ir.ui.view">
        <field name="name">x_planning.shift.list</field>
        <field name="model">x_planning.shift</field>
        <field name="arch" type="xml">
            <list string="Shift" default_order="x_start_datetime">
                <field name="x_partner_id"/>
                <field name="x_role_id"/>
                <field name="x_start_datetime"/>
                <field name="x_end_datetime"/>
                <button string="I take it" type="action" name="%(planning_shift_action_take_it)d" invisible="x_partner_id"/>
            </list>
        </field>
    </record>

    <!--
        Action
    -->
    <record id="planning_shift_action" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">x_planning.shift</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="planning_shift_view_search"/>
    </record>
    
    <record id="planning_shift_my_action" model="ir.actions.act_window">
        <field name="name">My Shifts</field>
        <field name="res_model">x_planning.shift</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="planning_shift_view_search"/>
        <field name="context">{"search_default_filter_my_shifts": 1}</field>
    </record>

</odoo>
