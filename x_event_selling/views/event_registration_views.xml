<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="event_registration_view_list" model="ir.ui.view">
        <field name="name">event.registration.list.inherit</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="x_sale_status" optional="show" widget="badge"
                    decoration-success="x_sale_status == 'sold'"
                    decoration-danger="x_sale_status == 'to_pay'"
                    invisible="not x_sale_status" />
                <field name="x_sale_price" widget="monetary" options="{'currency_field': 'x_currency_id'}" optional="hidden" sum="Total"/>
                <field name="x_currency_id" column_invisible="1"/>
            </field>
            <xpath expr="//button[@name='action_confirm']" position="before">
                <button string="Mark as Paid" type="action" name="%(x_event_selling.event_registration_action_mark_as_paid)d" icon="fa-dollar" invisible="x_sale_status in ['free', 'sold']"/>
                <button string="Mark as unpaid" type="action" name="%(x_event_selling.event_registration_action_mark_as_unpaid)d" icon="fa-dollar" invisible="x_sale_status in ['free', 'to_pay']"/>
            </xpath>
        </field>
    </record>

    <record id="event_registration_view_graph" model="ir.ui.view">
        <field name="name">event.registration.graph.inherit.event.sale</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_graph"/>
        <field name="arch" type="xml">
            <field name="event_id" position="after">
                <field name="x_sale_status"/>
            </field>
        </field>
    </record>

    <record id="event_registration_view_form" model="ir.ui.view">
        <field name="name">event.registration.form.inherit</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_send_badge_email']" position="before">
                <button string="Mark as Paid" type="action" name="%(x_event_selling.event_registration_action_mark_as_paid)d" invisible="x_sale_status in ['free', 'sold']" class="oe_highlight"/>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="after">
                <button string="Mark as unpaid" type="action" name="%(x_event_selling.event_registration_action_mark_as_unpaid)d" invisible="x_sale_status in ['free', 'to_pay']"/>
            </xpath>
            <xpath expr="//group" position="before">
                <widget name="web_ribbon" title="Sold" bg_color="text-bg-success"
                    invisible="x_sale_status != 'sold'"/>
                <widget name="web_ribbon" title="Not Sold" bg_color="text-bg-info"
                    invisible="not x_sale_status or x_sale_status in ('sold', 'free') or not id"/>
            </xpath>
            <group name="utm_link" position="before">
                <group string="Sales" name="sale_details">
                    <field name="x_sale_status"/>
                    <field name="x_sale_price" widget="monetary" options="{'currency_field': 'x_currency_id'}" invisible="x_sale_status == 'free'"/>
                    <field name="x_currency_id" invisible="1"/>
                </group>
            </group>
        </field>
    </record>

    <record id="event_registration_view_kanban" model="ir.ui.view">
        <field name="name">event.registration.kanban.inherit</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.event_registration_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='event_ticket_id']" position="after">
                <footer>
                    <field name="x_sale_status" widget="badge" decoration-success="x_sale_status == 'sold'" decoration-danger="x_sale_status == 'to_pay'"/>
                </footer>
            </xpath>
        </field>
    </record>

    <record id="event_registration_view_search" model="ir.ui.view">
        <field name="name">event.registration.view.search.inherit</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_registration_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group/filter[@name='status']" position="after">
                <filter string="Sale Status" name="sale_status" domain="[]" context="{'group_by':'x_sale_status'}"/>

            </xpath>
        </field>
    </record>

</odoo>
