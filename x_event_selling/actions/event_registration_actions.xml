<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!--
        Actions
    -->
    <record id="event_registration_action_mark_as_paid" model="ir.actions.server">
        <field name="name">Mark as Paid</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="binding_model_id" ref="event.model_event_registration"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            records.filtered(lambda rec: rec.x_sale_status == 'to_pay').write({"x_sale_status": "sold"})
        </field>
    </record>

    <record id="event_registration_action_mark_as_unpaid" model="ir.actions.server">
        <field name="name">Mark as Unpaid</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="binding_model_id" ref="event.model_event_registration"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            records.filtered(lambda rec: rec.x_sale_status == 'sold').write({"x_sale_status": "to_pay"})
        </field>
    </record>

</odoo>
