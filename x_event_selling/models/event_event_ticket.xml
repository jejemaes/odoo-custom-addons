<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="event_event_ticket_field_price" model="ir.model.fields">
        <field name="name">x_price</field>
        <field name="ttype">float</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Price</field>
        <field name="model">event.event.ticket</field>
        <field name="model_id" ref="event.model_event_event_ticket"/>
        <field name="required" eval="False"/>
    </record>

    <record id="event_event_ticket_field_currency_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="field_description">Currency</field>
        <field name="model">event.event.ticket</field>
        <field name="model_id" ref="event.model_event_event_ticket"/>
        <field name="name">x_currency_id</field>
        <field name="relation">res.currency</field>
        <field name="related">event_id.x_currency_id</field>
        <field name="readonly" eval="True"/>
    </record>

</odoo>
