<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="x_budget_budget_position_view_search" model="ir.ui.view">
        <field name="name">x_budget.budget.position.search</field>
        <field name="model">x_budget.budget.position</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_budget_id"/>
                <field name="x_category_id"/>
                <group>
                    <filter string="Category" name="groupby_category_id" context="{'group_by':'x_category_id'}"/>
                    <filter string="Budget" name="groupby_budget_id" context="{'group_by':'x_budget_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="x_budget_budget_position_view_form" model="ir.ui.view">
        <field name="name">x_budget.budget.position.form</field>
        <field name="model">x_budget.budget.position</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet string="Budget Position">
                    <div class="oe_title">
                        <h1>
                            <field name="x_name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="x_budget_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="x_name"/>
                                <field name="x_planned_amount" sum="Total"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_budget_budget_position_view_pivot" model="ir.ui.view" >
        <field name="name">x_budget.budget.position.pivot</field>
        <field name="model">x_budget.budget.position</field>
        <field name="arch" type="xml">
            <pivot string="Budget Pivot" sample="1">
                <field name="x_category_id" type="col"/>
                <field name="x_budget_id" type="row"/>
                <field name="x_planned_amount" type="measure" string="Theorical Amount"/>
                <field name="x_practical_amount" type="measure" string="Practical Amount"/>
            </pivot>
        </field>
    </record>

    <record id="x_budget_budget_position_view_graph" model="ir.ui.view" >
        <field name="name">x_budget.budget.position.graph</field>
        <field name="model">x_budget.budget.position</field>
        <field name="arch" type="xml">
            <pivot string="Budget Graph" sample="1">
                <field name="x_category_id" type="col"/>
                <field name="x_budget_id" type="row"/>
                <field name="x_planned_amount" type="measure" string="Theorical Amount"/>
                <field name="x_practical_amount" type="measure" string="Practical Amount"/>
            </pivot>
        </field>
    </record>

    <record id="x_budget_budget_position_action_reporting" model="ir.actions.act_window" >
        <field name="name">Budget Reporting</field>
        <field name="res_model">x_budget.budget.position</field>
        <field name="view_mode">graph,pivot</field>
    </record>

</odoo>
