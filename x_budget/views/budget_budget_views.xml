<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="budget_budget_view_list" model="ir.ui.view" >
        <field name="name">x_budget.budget.list</field>
        <field name="model">x_budget.budget</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="x_name"/>
                <field name="x_user_id" widget="many2one_avatar_user"/>
                <field name="x_analytic_account_id"/>
            </list>
        </field>
    </record>

    <record id="budget_budget_view_kanban" model="ir.ui.view">
        <field name="name">x_budget.budget.kanban</field>
        <field name="model">x_budget.budget</field>
        <field name="arch" type="xml">
            <kanban default_order="create_date DESC" class="o_budget_kanban">
                <field name="id"/>
                <field name="x_name"/>
                <field name="x_user_id"/>
                <field name="x_uncategorized_line_count"/>
                <field name="x_use_planned_amount"/>
                <field name="x_currency_id"/>
                <field name="x_total_planned_amount"/>
                <field name="x_total_practical_amount"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable">
                            <a type="open" class="dropdown-item">Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a type="delete" class="dropdown-item">Delete</a>
                        </t>
                    </t>
                    <t t-name="card">
                        <main t-att-data-id="record.id.raw_value">
                            <div class="d-flex align-items-baseline gap-1 p-2">
                                <field name="x_name" class="text-truncate h1"/>
                            </div>
                            <div class="min-w-0 row me-2 mb-2">
                                <div class="d-flex flex-column align-items-center col-6 border-end" t-if="record.x_use_planned_amount.raw_value">
                                    <p class="text-muted">Planned</p>
                                    <span t-attf-class="{{record.x_total_planned_amount.raw_value >= 0 ? 'text-success' : 'text-danger'}} h2">
                                        <t t-esc="record.x_total_planned_amount.value"/>
                                    </span>
                                </div>
                                <div class="d-flex flex-column align-items-center col-6 border-end">
                                    <p class="text-muted">Effective</p>
                                    <span t-attf-class="{{record.x_total_practical_amount.raw_value >= 0 ? 'text-success' : 'text-danger'}} h2">
                                        <t t-esc="record.x_total_practical_amount.value"/>
                                    </span>
                                </div>
                            </div>
                        </main>
                        <footer>
                            <div class="d-flex align-items-center">
                                <a class="text-danger small d-block" t-if="record.x_uncategorized_line_count.raw_value"
                                    type="action" name="%(x_budget.action_budget_budget_goto_uncategorized_analytic_lines)d">
                                    <i class="fa fa-exclamation-triangle me-1"/><t t-esc="record.x_uncategorized_line_count.value"/> uncategorized analytic line(s)
                                </a>
                            </div>
                            <div class="d-flex ms-auto align-items-center">
                                <field name="activity_ids" widget="kanban_activity"/>
                                <field name="x_user_id" widget="many2one_avatar_user"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="budget_budget_view_form" model="ir.ui.view" >
        <field name="name">x_budget.budget.form</field>
        <field name="model">x_budget.budget</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet string="Budgets">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="%(x_budget.action_budget_budget_goto_analytic_lines)d"
                                type="action" icon="fa-bars">
                            <div class="o_stat_info">
                                <span class="o_stat_text">
                                    Effective Lines
                                </span>
                            </div>
                        </button>
                    </div>
                    <field name="x_currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <div class="alert alert-warning d-flex justify-content-between align-items-center" role="alert" invisible="not x_uncategorized_line_count">
                        <span><field name="x_uncategorized_line_count" nolabel="1" class="oe_inline"/> analytic line(s) linked to this budget's analytic account are not categorized in this budget.</span>
                        <button type="action" name="%(x_budget.action_budget_budget_goto_uncategorized_analytic_lines)d"
                                string="View Lines" class="btn btn-link p-0"/>
                    </div>
                    <group name="budget_options">
                        <div class="d-flex flex-row gap-4">
                            <div class="o_row">
                                <field name="x_use_dates"/>
                                <label for="x_use_dates" string="Use Dates"/>
                            </div>
                            <div class="o_row">
                                <field name="x_use_planned_amount"/>
                                <label for="x_use_planned_amount" string="Use Planned Amount"/>
                            </div>
                        </div>
                    </group>
                    <group name="budget_detail">
                        <group name="budget_detail_left">
                            <field name="x_analytic_account_id" options="{'no_create': True}"/>
                            <label for="x_start_date" string="Dates" invisible="x_use_dates == False"/>
                            <div class="o_row" invisible="x_use_dates == False">
                                <field name="x_start_date" widget="daterange" required="x_use_dates" options="{'end_date_field': 'x_stop_date', 'show_time': False, 'always_range': '1'}"/>
                                <field name="x_stop_date" required="x_use_dates" invisible="1"/> <!-- otherwise it is visible, smort -->
                            </div>
                        </group>
                        <group name="budget_detail_right">
                            <field name="x_user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                            <field name="x_company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_selectable_category_ids" widget="many2many_tags" options="{'color_field': 'x_color'}" invisible="1"/>
                    </group>
                    <notebook>
                        <page name="budget_line_details" string="Balance">
                            <field name="x_position_ids" readonly="0" context="{
                                'form_view_ref': 'x_budget.x_budget_budget_position_view_form'
                            }">
                                <list default_order="x_sequence">
                                    <field name="x_currency_id" column_invisible="1"/>
                                    <field name="x_sequence" widget="handle"/>
                                    <field name="x_color" widget="color_picker" string="" width="20"/>
                                    <field name="x_category_id" options="{'no_create': True}" domain="[('id', 'in', parent.x_selectable_category_ids)]"/>
                                    <field name="x_planned_amount" width="180" column_invisible="not parent.x_use_planned_amount"/>
                                    <field name="x_practical_amount" width="180"/>
                                </list>
                                <form>
                                    <sheet string="Budget Position">
                                        <field name="x_currency_id" invisible="1"/>
                                        <group>
                                            <field name="x_category_id" options="{'no_create': True}" domain="[('id', 'in', parent.x_selectable_category_ids)]" class="oe_title"/>
                                        </group>
                                        <group invisible="not parent.x_use_planned_amount">
                                            <field name="x_budget_line_ids" nolabel="1">
                                                <list editable="bottom">
                                                    <field name="x_currency_id" column_invisible="1"/>
                                                    <field name="x_sequence" widget="handle"/>
                                                    <field name="x_name"/>
                                                    <field name="x_planned_amount" sum="Total" width="180"/>
                                                </list>
                                            </field>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="x_note" placeholder="Write notes here ..." nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                    <group name="budget_totals" class="oe_subtotal_footer">
                        <field name="x_total_planned_amount" invisible="not x_use_planned_amount" decoration-success="x_total_planned_amount &gt;= 0" decoration-danger="x_total_planned_amount &lt; 0" class="h2"/>
                        <field name="x_total_practical_amount" decoration-success="x_total_practical_amount &gt;= 0" decoration-danger="x_total_practical_amount &lt; 0" class="h2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="budget_budget_view_search" model="ir.ui.view" >
        <field name="name">x_budget.budget.search</field>
        <field name="model">x_budget.budget</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_user_id"/>
                <field name="x_analytic_account_id"/>
                <filter string="My Budgets" name="my_budget" domain="[['x_user_id', '=', uid]]"/>
                <separator/>
                <group>
                    <filter name="groupby_x_user" string="Responsable" context="{'group_by': 'x_user_id'}" domain="[]"/>
                    <filter name="groupby_x_analytic_account_id" string="Analytic Account" context="{'group_by': 'x_analytic_account_id'}" domain="[]"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="budget_budget_action" model="ir.actions.act_window">
        <field name="name">Budget</field>
        <field name="res_model">x_budget.budget</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_x_user_id': uid,
        }</field>
    </record>

</odoo>
