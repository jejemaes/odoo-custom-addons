<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="budget_budget_view_list" model="ir.ui.view" >
        <field name="name">x_budget.budget.list</field>
        <field name="model">x_budget.budget</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="x_name"/>
                <field name="x_user_id" widget="many2one_avatar_user"/>
                <field name="x_analytic_account_id"/>
            </list>
        </field>
    </record>

    <record id="budget_budget_view_kanban" model="ir.ui.view">
        <field name="name">x_budget.budget.kanban</field>
        <field name="model">x_budget.budget</field>
        <field name="arch" type="xml">
            <kanban default_order="create_date DESC" class="o_budget_kanban">
                <field name="id"/>
                <field name="x_name"/>
                <field name="x_user_id"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable">
                            <a type="open" class="dropdown-item">Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a type="delete" class="dropdown-item">Delete</a>
                        </t>
                    </t>
                    <t t-name="card">
                        <div class="d-flex flex-column o_kanban_attachment o_budget_kanban_record h-100 pb-1" t-att-data-id="record.id.raw_value">
                            <div class="flex-shrink-1 flex-auto">
                                <div class="p-2 pb-0">
                                    <div class="fw-bolder w-100 d-flex align-items-center">
                                        <div class="d-flex flex-grow-1 align-items-center gap-2 overflow-hidden">
                                            <field name="x_name" class="text-truncate"/>
                                        </div>
                                        <div class="d-flex d-flex-row align-items-center ms-2 gap-2">
                                            <field name="activity_ids" widget="kanban_activity"/>
                                            <field name="x_user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="budget_budget_view_form" model="ir.ui.view" >
        <field name="name">x_budget.budget.form</field>
        <field name="model">x_budget.budget</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet string="Budgets">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="%(x_budget.action_budget_budget_goto_analytic_lines)d"
                                type="action" icon="fa-bars">
                            <div class="o_stat_info">
                                <span class="o_stat_text">
                                    Practical Lines
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group name="budget_detail">
                        <group name="budget_detail_left">
                            <label for="x_start_date" string="Dates"/>
                            <div class="o_row">
                                <field name="x_start_date" widget="daterange" options="{'end_date_field': 'x_stop_date', 'show_time': False, 'always_range': '1'}"/>
                                <field name="x_stop_date" invisible="1"/> <!-- otherwise it is visible, smort -->
                            </div>
                            <field name="x_analytic_account_id" options="{'no_create': True}"/>
                        </group>
                        <group name="budget_detail_right">
                            <field name="x_user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_selectable_category_ids" widget="many2many_tags" options="{'color_field': 'x_color'}" invisible="1"/>
                    </group>
                    <notebook>
                        <page name="budget_line_details" string="Balance">
                            <field name="x_position_ids" readonly="0" context="{
                                'form_view_ref': 'x_budget.x_budget_budget_position_view_form'
                            }">
                                <list>
                                    <field name="x_color" widget="color_picker" string="" width="20"/>
                                    <field name="x_category_id" options="{'no_create': True}" domain="[('id', 'in', parent.x_selectable_category_ids)]"/>
                                    <field name="x_planned_amount" sum="Total" width="180"/>
                                    <field name="x_practical_amount" sum="Total" width="180"/>
                                </list>
                                <form>
                                    <sheet string="Budget Position">
                                        <group>
                                            <field name="x_category_id" options="{'no_create': True}" domain="[('id', 'in', parent.x_selectable_category_ids)]" class="oe_title"/>
                                        </group>
                                        <group>
                                            <field name="x_budget_line_ids" nolabel="1">
                                                <list editable="bottom">
                                                    <field name="x_sequence" widget="handle"/>
                                                    <field name="x_name"/>
                                                    <field name="x_planned_amount" sum="Total" width="180"/>
                                                </list>
                                            </field>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="x_note" placeholder="Write notes here ..." nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="budget_budget_view_search" model="ir.ui.view" >
        <field name="name">x_budget.budget.search</field>
        <field name="model">x_budget.budget</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_user_id"/>
                <field name="x_analytic_account_id"/>
                <filter string="My Budgets" name="my_budget" domain="[['x_user_id', '=', uid]]"/>
                <separator/>
                <group>
                    <filter name="groupby_x_user" string="Responsable" context="{'group_by': 'x_user_id'}" domain="[]"/>
                    <filter name="groupby_x_analytic_account_id" string="Analytic Account" context="{'group_by': 'x_analytic_account_id'}" domain="[]"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="budget_budget_action" model="ir.actions.act_window">
        <field name="name">Budget</field>
        <field name="res_model">x_budget.budget</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_x_user_id': uid,
        }</field>
    </record>

</odoo>
