<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Views -->
    <record id="account_analytic_line_view_list" model="ir.ui.view" >
        <field name="name">account.analytic.line.list</field>
        <field name="model">account.analytic.line</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date" optional="show"/>
                <field name="name"/>
                <field name="amount" sum="Total" optional="show"/>
                <field name="x_budget_category_id"/>
                <field name="unit_amount" sum="Quantity" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="account_analytic_line_view_form" model="ir.ui.view" >
        <field name="name">account.analytic.line.form</field>
        <field name="model">account.analytic.line</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <group>
                        <group name="analytic_item" string="Analytic Item">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                        </group>
                        <group name="amount" string="Amount">
                            <field name="amount"/>
                            <field name="unit_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="x_budget_category_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_analytic_line_view_search" model="ir.ui.view" >
        <field name="name">account.analytic.line.search</field>
        <field name="model">account.analytic.line</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="x_budget_category_id"/>
                <filter string="Uncategorized" name="filter_budget_uncategorized" domain="[('x_budget_category_id','=', False)]"/>
                <group>
                    <filter string="Category" name="category" context="{'group_by':'x_budget_category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="account_analytic_line_view_pivot" model="ir.ui.view" >
        <field name="name">account.analytic.line.pivot</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <pivot string="Analytic Lines" sample="1">
                <field name="x_budget_category_id" type="col"/>
                <field name="x_amount_type" type="row"/>
                <field name="amount" type="measure" string="Amount"/>
            </pivot>
        </field>
    </record>

    <!-- Views -->
    <record id="account_analytic_line_action" model="ir.actions.act_window" >
        <field name="name">Analytic Line</field>
        <field name="res_model">account.analytic.line</field>
    </record>

    <record id="account_analytic_line_action_view_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="account_analytic_line_action"/>
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account_analytic_line_view_list"/>
    </record>

    <record id="account_analytic_line_action_view_pivot" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="account_analytic_line_action"/>
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="account_analytic_line_view_pivot"/>
    </record>

    <record id="account_analytic_line_action_view_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="account_analytic_line_action"/>
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account_analytic_line_view_form"/>
    </record>

</odoo>
