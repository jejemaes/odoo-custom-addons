<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Model -->
    <record id="model_budget_budget_line" model="ir.model">
        <field name="name">Budget Line</field>
        <field name="model">x_budget.budget.line</field>
    </record>

    <!-- Fields -->
    <record id="model_budget_budget_line_field_name" model="ir.model.fields">
        <field name="ttype">char</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Name</field>
        <field name="model">x_budget.budget.line</field>
        <field name="model_id" ref="model_budget_budget_line"/>
        <field name="name">x_name</field>
        <field name="on_delete" eval="False"/>
        <field name="required" eval="True"/>
        <field name="translate">standard</field>
    </record>

    <record id="model_budget_budget_line_field_position_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="required" eval="True"/>
        <field name="field_description">Position</field>
        <field name="model">x_budget.budget.line</field>
        <field name="model_id" ref="model_budget_budget_line"/>
        <field name="name">x_position_id</field>
        <field name="relation">x_budget.budget.position</field>
        <field name="on_delete">cascade</field>
        <field name="domain" eval="False"/>
    </record>

    <record id="model_budget_budget_line_field_sequence" model="ir.model.fields">
        <field name="ttype">integer</field>
        <field name="field_description">Sequence</field>
        <field name="model">x_budget.budget.line</field>
        <field name="model_id" ref="model_budget_budget_line"/>
        <field name="name">x_sequence</field>
    </record>

    <record id="model_budget_budget_line_field_planned_amount" model="ir.model.fields">
        <field name="name">x_planned_amount</field>
        <field name="ttype">float</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Planned Amount</field>
        <field name="model">x_budget.budget.line</field>
        <field name="model_id" ref="model_budget_budget_line"/>
        <field name="required" eval="True"/>
    </record>

    <record id="model_budget_budget_line_field_budget_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="required" eval="False"/>
        <field name="field_description">Budget</field>
        <field name="model">x_budget.budget.line</field>
        <field name="model_id" ref="model_budget_budget_line"/>
        <field name="name">x_budget_id</field>
        <field name="relation">x_budget.budget</field>
        <field name="on_delete">cascade</field>
        <field name="domain" eval="False"/>
        <field name="related">x_position_id.x_budget_id</field>
        <field name="readonly" eval="True"/>
    </record>

    <record id="model_budget_budget_line_field_currency_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="field_description">Currency</field>
        <field name="model">x_budget.budget.line</field>
        <field name="model_id" ref="model_budget_budget_line"/>
        <field name="name">x_currency_id</field>
        <field name="relation">res.currency</field>
        <field name="related">x_budget_id.x_currency_id</field>
        <field name="readonly" eval="True"/>
        <field name="store" eval="True"/>
    </record>

    <!--
        Budget Position
    -->
    <record id="model_budget_budget_position_field_budget_line_ids" model="ir.model.fields">
        <field name="ttype">one2many</field>
        <field name="field_description">Budget Lines</field>
        <field name="model">x_budget.budget.position</field>
        <field name="model_id" ref="model_budget_budget_position"/>
        <field name="name">x_budget_line_ids</field>
        <field name="on_delete">cascade</field>
        <field name="relation">x_budget.budget.line</field>
        <field name="relation_field">x_position_id</field>
    </record>

    <record id="model_budget_budget_position_field_planned_amount" model="ir.model.fields">
        <field name="name">x_planned_amount</field>
        <field name="ttype">float</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Planned Amount</field>
        <field name="model">x_budget.budget.position</field>
        <field name="model_id" ref="model_budget_budget_position"/>
        <field name="required" eval="False"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_budget_line_ids.x_planned_amount</field>
        <field name="compute"><![CDATA[
data = self.env['x_budget.budget.line']._read_group(
    domain=[
        ('x_position_id', 'in', self.ids),
    ],
    groupby=['x_position_id'],
    aggregates=['x_planned_amount:sum'],
)
data = {int(x_position_id): amount_sum for x_position_id, amount_sum in data}

for record in self:
    record["x_planned_amount"] = data.get(record.id, 0)
]]></field>
        <field name="store" eval="True"/>
    </record>

    <record id="model_budget_budget_position_field_practical_amount" model="ir.model.fields">
        <field name="name">x_practical_amount</field>
        <field name="ttype">float</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Effective Amount</field>
        <field name="model">x_budget.budget.position</field>
        <field name="model_id" ref="model_budget_budget_position"/>
        <field name="required" eval="False"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_budget_id.x_use_dates,x_budget_id.x_start_date,x_budget_id.x_stop_date,x_budget_id.x_analytic_account_id,x_category_id.x_analytic_line_ids.amount,x_category_id.x_analytic_line_ids.account_id,x_category_id.x_analytic_line_ids.date</field>
        <field name="compute"><![CDATA[
for budget, positions in self.grouped('x_budget_id').items():

    domain = [
        ('account_id', '=', budget.x_analytic_account_id.id),
        ('x_budget_category_id', 'in', positions.mapped('x_category_id').ids),
    ]
    if budget.x_use_dates and budget.x_start_date and budget.x_stop_date:
        domain += [('date', '>=', budget.x_start_date), ('date', '<=', budget.x_stop_date)]

    data = self.env['account.analytic.line']._read_group(
        domain=domain,
        groupby=['x_budget_category_id'],
        aggregates=['amount:sum'],
    )

    data = {int(budget_category_id): amount_sum for budget_category_id, amount_sum in data}

    for record in self:
        record["x_practical_amount"] = data.get(record.x_category_id.id, 0)
]]></field>
        <field name="store" eval="True"/>
    </record>

    <!--
        Budget Budget
    -->
    <record id="model_budget_budget_field_line_ids" model="ir.model.fields">
        <field name="ttype">one2many</field>
        <field name="field_description">Lines</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_line_ids</field>
        <field name="on_delete" eval="False"/>
        <field name="relation">x_budget.budget.line</field>
        <field name="relation_field">x_budget_id</field>
    </record>

    <record id="model_budget_budget_field_uncategorized_line_count" model="ir.model.fields">
        <field name="name">x_uncategorized_line_count</field>
        <field name="ttype">integer</field>
        <field name="field_description">Uncategorized Analytic Lines</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_analytic_account_id,x_use_dates,x_start_date,x_stop_date,x_category_ids</field>
        <field name="compute"><![CDATA[
undated_budgets = self.browse()
dated_budgets = self.browse()
for budget in self:
    if not budget.x_analytic_account_id:
        budget['x_uncategorized_line_count'] = 0
    elif budget.x_use_dates and budget.x_start_date and budget.x_stop_date:
        dated_budgets += budget
    else:
        undated_budgets += budget

# budgets without a date range share the same (account, category) counts, so they
# can be resolved with a single grouped query instead of one search_count each.
if undated_budgets:
    data = self.env['account.analytic.line']._read_group(
        domain=[('account_id', 'in', undated_budgets.x_analytic_account_id.ids)],
        groupby=['account_id', 'x_budget_category_id'],
        aggregates=['__count'],
    )
    counts_by_account = {}
    for account_id, category_id, count in data:
        counts_by_account.setdefault(int(account_id), {})[int(category_id) if category_id else False] = count

    for budget in undated_budgets:
        category_counts = counts_by_account.get(budget.x_analytic_account_id.id, {})
        excluded_category_ids = set(budget.x_category_ids.ids)
        budget['x_uncategorized_line_count'] = sum(
            count for category_id, count in category_counts.items()
            if category_id not in excluded_category_ids
        )

# budgets with a date range each have their own bounds, so they still need a query each.
for budget in dated_budgets:
    domain = [
        ('account_id', '=', budget.x_analytic_account_id.id),
        ('x_budget_category_id', 'not in', budget.x_category_ids.ids),
        ('date', '>=', budget.x_start_date),
        ('date', '<=', budget.x_stop_date),
    ]
    budget['x_uncategorized_line_count'] = self.env['account.analytic.line'].search_count(domain)
]]></field>
        <field name="store" eval="False"/>
    </record>

    <record id="model_budget_budget_field_total_planned_amount" model="ir.model.fields">
        <field name="name">x_total_planned_amount</field>
        <field name="ttype">monetary</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Total Planned Amount</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_position_ids.x_planned_amount</field>
        <field name="compute"><![CDATA[
for budget in self:
    budget['x_total_planned_amount'] = sum(budget.x_position_ids.mapped('x_planned_amount'))
]]></field>
        <field name="store" eval="True"/>
    </record>

    <record id="model_budget_budget_field_total_practical_amount" model="ir.model.fields">
        <field name="name">x_total_practical_amount</field>
        <field name="ttype">monetary</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Total Effective Amount</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_position_ids.x_practical_amount</field>
        <field name="compute"><![CDATA[
for budget in self:
    budget['x_total_practical_amount'] = sum(budget.x_position_ids.mapped('x_practical_amount'))
]]></field>
        <field name="store" eval="True"/>
    </record>

</odoo>
