<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Model -->
    <record id="model_budget_budget" model="ir.model">
        <field name="name">Budget</field>
        <field name="model">x_budget.budget</field>
        <field name="is_mail_thread" eval="True"/>
        <field name="is_mail_activity" eval="True"/>
    </record>

    <!-- Fields -->
    <record id="model_budget_budget_field_name" model="ir.model.fields">
        <field name="ttype">char</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Name</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_name</field>
        <field name="on_delete" eval="False"/>
        <field name="required" eval="True"/>
        <field name="tracking">1</field>
        <field name="translate">standard</field>
    </record>
    <record id="model_budget_budget_field_user_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="domain">[('share', '=', False)]</field>
        <field name="field_description">Responsable</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_user_id</field>
        <field name="relation">res.users</field>
        <field name="tracking">1</field>
    </record>
    <record id="model_budget_budget_field_start_date" model="ir.model.fields">
        <field name="ttype">date</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Start Date</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_start_date</field>
        <field name="on_delete" eval="False"/>
    </record>
    <record id="model_budget_budget_field_stop_date" model="ir.model.fields">
        <field name="ttype">date</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Stop Date</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_stop_date</field>
        <field name="on_delete" eval="False"/>
    </record>
    <record id="model_budget_budget_field_analytic_account_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="required" eval="True"/>
        <field name="field_description">Analytic Account</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_analytic_account_id</field>
        <field name="relation">account.analytic.account</field>
        <field name="domain" eval="False"/>
        <field name="on_delete">restrict</field>
        <field name="tracking">2</field>
    </record>

    <record id="model_budget_budget_field_note" model="ir.model.fields">
        <field name="name">x_note</field>
        <field name="ttype">html</field>
        <field name="copied" eval="False"/>
        <field name="field_description">Note</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="on_delete" eval="False"/>
    </record>


</odoo>