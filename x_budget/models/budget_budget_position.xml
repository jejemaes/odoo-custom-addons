<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Model -->
    <record id="model_budget_budget_position" model="ir.model">
        <field name="model">x_budget.budget.position</field>
        <field name="name">Budget Position</field>
    </record>

    <!-- Fields -->
    <record id="model_budget_budget_position_field_category_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="required" eval="True"/>
        <field name="field_description">Category</field>
        <field name="model">x_budget.budget.position</field>
        <field name="model_id" ref="model_budget_budget_position"/>
        <field name="name">x_category_id</field>
        <field name="relation">x_budget.category</field>
        <field name="on_delete">cascade</field>
        <field name="domain" eval="False"/>
    </record>

    <record id="model_budget_budget_position_field_category_color" model="ir.model.fields">
        <field name="ttype">integer</field>
        <field name="field_description">Category's color</field>
        <field name="model">x_budget.budget.position</field>
        <field name="model_id" ref="model_budget_budget_position"/>
        <field name="name">x_color</field>
        <field name="related">x_category_id.x_color</field>
        <field name="readonly" eval="True"/>
    </record>

    <record id="model_budget_budget_position_field_budget_id" model="ir.model.fields">
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="required" eval="True"/>
        <field name="field_description">Budget</field>
        <field name="model">x_budget.budget.position</field>
        <field name="model_id" ref="model_budget_budget_position"/>
        <field name="name">x_budget_id</field>
        <field name="relation">x_budget.budget</field>
        <field name="on_delete">cascade</field>
        <field name="domain" eval="False"/>
    </record>
    <record id="model_budget_budget_field_position_ids" model="ir.model.fields">
        <field name="ttype">one2many</field>
        <field name="field_description">Budget Positions</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_position_ids</field>
        <field name="on_delete" eval="False"/>
        <field name="relation">x_budget.budget.position</field>
        <field name="relation_field">x_budget_id</field>
    </record>

    <record id="model_budget_budget_position_field_name" model="ir.model.fields">
        <field name="ttype">char</field>
        <field name="copied" eval="False"/>
        <field name="field_description">Name</field>
        <field name="model">x_budget.budget.position</field>
        <field name="model_id" ref="model_budget_budget_position"/>
        <field name="name">x_name</field>
        <field name="readonly" eval="True"/>
        <field name="required" eval="False"/>
        <field name="store" eval="True"/>
        <field name="depends">x_category_id</field>
        <field name="compute"><![CDATA[
for record in self:
    name = "#"
    if record.x_category_id:
        name = record.x_category_id.display_name
    record["x_name"] = name
]]></field>
    </record>

    <!-- This m2m must be declared after the 2 o2m relations-->
    <record id="model_budget_budget_field_category_ids" model="ir.model.fields">
        <field name="name">x_category_ids</field>
        <field name="ttype">many2many</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Categories</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="on_delete" eval="False"/>
        <field name="relation">x_budget.category</field>
        <field name="relation_table">x_budget_budget_position</field>
        <field name="column1">x_budget_id</field>
        <field name="column2">x_category_id</field>
    </record>

    <record id="model_budget_budget_field_selectable_category_ids" model="ir.model.fields">
        <field name="ttype">many2many</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Selectable Category</field>
        <field name="model">x_budget.budget</field>
        <field name="model_id" ref="model_budget_budget"/>
        <field name="name">x_selectable_category_ids</field>
        <field name="on_delete">cascade</field>
        <field name="relation">x_budget.category</field>
        <field name="store" eval="False"/>
        <field name="depends">x_position_ids.x_category_id</field>
        <field name="compute"><![CDATA[
categories = self.env['x_budget.category'].search([])
for record in self:
    record["x_selectable_category_ids"] = categories - self.x_position_ids.mapped('x_category_id')
]]></field>
    </record>

</odoo>
