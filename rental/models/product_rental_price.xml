<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Model -->
    <record id="model_product_rental_price" model="ir.model">
        <field name="name">Rental Price</field>
        <field name="model">x_product_rental_price</field>
        <field name="is_mail_thread" eval="False"/>
        <field name="is_mail_activity" eval="False"/>
    </record>

    <!-- Fields -->
    <record id="resource_resource_field_product_template_id" model="ir.model.fields">
        <field name="name">x_product_template_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Product Template</field>
        <field name="model">x_product_rental_price</field>
        <field name="model_id" ref="model_product_rental_price"/>
        <field name="relation">product.template</field>
        <field name="domain">[('x_rent_ok', '=', True)]</field>
    </record>

    <record id="product_rental_price_field_price" model="ir.model.fields">
        <field name="name">x_price</field>
        <field name="ttype">float</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Price</field>
        <field name="model">x_product_rental_price</field>
        <field name="model_id" ref="model_product_rental_price"/>
        <field name="required" eval="True"/>
    </record>

    <record id="product_rental_price_field_rental_day_ids" model="ir.model.fields">
        <field name="name">x_rental_day_ids</field>
        <field name="ttype">many2many</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Days</field>
        <field name="model">x_product_rental_price</field>
        <field name="model_id" ref="model_product_rental_price"/>
        <field name="on_delete" eval="False"/>
        <field name="relation">x_product_rental_day</field>
        <field name="relation_table">x_product_rental_price_day_rel</field>
    </record>

</odoo>
