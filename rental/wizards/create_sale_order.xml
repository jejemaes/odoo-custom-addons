<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Model -->
    <record id="model_rental_link_sale_order" model="ir.model">
        <field name="name">Create Sale Order</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="transient" eval="False"/>
        <field name="is_mail_thread" eval="False"/>
        <field name="is_mail_activity" eval="False"/>
    </record>

    <!-- Fields -->
    <record id="rental_link_sale_order_field_booking_id" model="ir.model.fields">
        <field name="name">x_rental_booking_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Booking</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="relation">x_rental_booking</field>
        <field name="required" eval="True"/>
        <field name="on_delete">cascade</field>
    </record>

    <record id="rental_link_sale_order_field_partner_id" model="ir.model.fields">
        <field name="name">x_partner_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Contact</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="relation">res.partner</field>
        <field name="readonly" eval="False"/>
        <field name="depends">x_rental_booking_id</field>
        <field name="compute"><![CDATA[
for record in self:
    if not record.x_partner_id and record.x_rental_booking_id:
        record["x_partner_id"] = record.x_rental_booking_id.x_partner_id.id
]]></field>
    </record>
    <record id="rental_link_sale_order_field_partner_shipping_id" model="ir.model.fields">
        <field name="name">x_partner_shipping_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Delivery Adress</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="relation">res.partner</field>
        <field name="readonly" eval="False"/>
        <field name="depends">x_rental_booking_id</field>
        <field name="compute"><![CDATA[
for record in self:
    if not record.x_partner_shipping_id and record.x_rental_booking_id:
        record["x_partner_shipping_id"] = record.x_rental_booking_id.x_partner_shipping_id.id
]]></field>
    </record>

    <record id="rental_link_sale_order_field_date_start" model="ir.model.fields">
        <field name="name">x_date_start</field>
        <field name="ttype">datetime</field>
        <field name="related">x_rental_booking_id.x_date_start</field>
        <field name="field_description">Start Date</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="readonly" eval="True"/>
    </record>
    <record id="rental_link_sale_order_field_date_stop" model="ir.model.fields">
        <field name="name">x_date_stop</field>
        <field name="ttype">datetime</field>
        <field name="related">x_rental_booking_id.x_date_stop</field>
        <field name="field_description">Date Stop</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="readonly" eval="True"/>
    </record>

    <record id="rental_link_sale_order_field_product_template_id" model="ir.model.fields">
        <field name="name">x_product_template_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="False"/>
        <field name="field_description">Product Template</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="relation">product.template</field>
        <field name="on_delete">cascade</field>
        <field name="readonly" eval="False"/>
        <field name="depends">x_rental_booking_id</field>
        <field name="compute"><![CDATA[
for record in self:
    if not record.x_product_template_id and record.x_rental_booking_id:
        record["x_product_template_id"] = record.x_rental_booking_id.x_resource_id.x_product_id.id if record.x_rental_booking_id.x_resource_id.x_product_id else False
]]></field>
    </record>
    <record id="rental_link_sale_order_field_product_id" model="ir.model.fields">
        <field name="name">x_product_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="False"/>
        <field name="field_description">Product</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="relation">product.product</field>
        <field name="readonly" eval="False"/>
        <field name="depends">x_rental_booking_id</field>
        <field name="compute"><![CDATA[
for record in self:
    if not record.x_product_id and record.x_rental_booking_id:
        product_template = record.x_rental_booking_id.x_resource_id.x_product_id
        if product_template:
            record["x_product_id"] = product_template.product_variant_ids[0]
]]></field>
    </record>

    <record id="rental_link_sale_order_field_resource_id" model="ir.model.fields">
        <field name="name">x_resource_id</field>
        <field name="ttype">many2one</field>
        <field name="copied" eval="True"/>
        <field name="field_description">Resource</field>
        <field name="model">x_rental_link_sale_order</field>
        <field name="model_id" ref="model_rental_link_sale_order"/>
        <field name="relation">resource.resource</field>
        <field name="related">x_rental_booking_id.x_resource_id</field>
    </record>


</odoo>
